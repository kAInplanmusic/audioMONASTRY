{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "server.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.responsive.config.ts",
    "scripts/**/*.{ts,mjs,cjs,js}",
    "services/*/index.{js,ts,mjs}",
    "services/*/src/index.{js,ts,mjs}",
    "tests/**/*.{test,spec}.{ts,tsx,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.{ts,mjs}",
    "services/**/*.{ts,js,mjs}",
    "scripts/**/*.{ts,mjs,cjs}",
    "tests/**/*.{ts,tsx,mjs}"
  ],
  "paths": {
    "@/*": [
      "src/*"
    ]
  },
  "ignore": [
    "**/*.d.ts",
    "coverage/**",
    "dist/**",
    "playwright-report/**",
    "public/sfu-rtp-test.js",
    "public/worklets/**",
    "services/backend-core/node/audio-routing.js",
    "services/backend-core/node/index.js",
    "src/ai/embeddingCache.ts",
    "src/ai/localVoice.ts",
    "src/ai/modelRegistry.ts",
    "src/components/B2BModal.tsx",
    "src/components/MasterTrackTerminal.tsx",
    "src/components/ModuleContainer.tsx",
    "src/components/RoomPlannerPanel.tsx",
    "src/components/SampleMonkLogo.tsx",
    "src/components/drop/index.ts",
    "src/config/webrtc.ts",
    "src/core/audio/backends/AudioBackend.ts",
    "src/core/audio/backends/NativeBackend.ts",
    "src/core/audio/backends/index.ts",
    "src/core/audio/runtime/NativeRuntimeSpawner.ts",
    "src/core/edge/EdgeDspClient.ts",
    "src/core/edge/FailoverController.ts",
    "src/core/hardware/HardwareSimulator.ts",
    "src/core/index.ts",
    "src/core/native/NativeAudioBackend.ts",
    "src/core/session/SessionSnapshot.ts",
    "src/core/session/stateReplication.ts",
    "src/core/spatial/SceneRenderers.ts",
    "src/core/spatial/ambisonics.ts",
    "src/core/spatial/hrtfInterpolator.ts",
    "src/core/transport/TransportRegistry.ts",
    "src/core/workers/AsyncSandbox.ts",
    "src/core/workers/RingBuffer.ts",
    "src/core/workers/WorkletPool.ts",
    "src/hooks/useAIComposition.ts",
    "src/hooks/useRoom.ts",
    "src/hooks/useSessionSync.ts",
    "src/lib/db.ts",
    "src/lib/firebase.ts",
    "src/types/composition.ts",
    "src/utils/presetStore.ts",
    "src/webgpu/webgpu_adapter.ts",
    "test-results/**"
  ],
  "ignoreDependencies": [
    "jscpd",
    "tailwindcss",
    "playwright",
    "mixer-.*",
    "ws",
    "midi",
    "osc"
  ],
  "ignoreUnresolved": [
    "mixer-.*"
  ],
  "ignoreBinaries": [
    "docker",
    "ffmpeg",
    "ffprobe",
    "exiftool",
    "sqlite3",
    "cua-driver"
  ]
}
