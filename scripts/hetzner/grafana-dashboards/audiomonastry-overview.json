            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"audiomonastry.*\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
