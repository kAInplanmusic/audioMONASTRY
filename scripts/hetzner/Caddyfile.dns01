# Caddyfile.combined – TLS-Terminator für Main + SFU
# =============================================================================

{
	servers {
		protocols h1 h2
	}
	acme_dns cloudflare {$CF_DNS_API_TOKEN}
}

(app_rumpf) {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# SFU-Signalisierung: hier gibt es keine SFU auf diesem Knoten (ENABLE_SFU=0, F6).
	# Die SFU-Socket.IO-Pfade werden separat behandelt.
	@sfuSignaling path /sfu-signaling/*
	respond @sfuSignaling "{\"error\":\"sfu-signaling-nicht-auf-diesem-knoten\",\"sfu\":\"{$SFU_SIGNALING_URL}\",\"hinweis\":\"SFU_SIGNALING_URL zeigt auf den SFU-Knoten\}" 404
	@sfuPreflight {
		method OPTIONS
		path /sfu-signaling/*
	}
	respond @sfuPreflight 204

	reverse_proxy audiomonastry:8080 {
		transport http {
			read_timeout 5m
			write_timeout 30s
		}
	}

	request_body {
		max_size 120MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(self), midi=(self)"
		-Server
		-X-Powered-By
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /worklets/* Cache-Control "public, max-age=86400"
	header /index.html Cache-Control "no-cache"
	header /api/* Cache-Control "no-store"
}

# HTTPS: Zertifikat per DNS-01
{$ORIGIN_HOST:origin.anunnakitools.de}, {$DOMAIN:anunnakitools.de} {
	tls {
		dns cloudflare {$CF_DNS_API_TOKEN}
	}
	import app_rumpf
}

# HTTP: für Portal-Worker
http://{$DOMAIN:anunnakitools.de} {
	import app_rumpf
}

# SFU-TKnoten: Socket.IO Signaling
{$SFU_HOST:sfu.anunnakitools.de} {
	tls {
		dns cloudflare {$CF_DNS_API_TOKEN}
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}

	# Socket.IO Client sendet an /sfu-signaling/socket.io/?EIO=4&transport=polling
	@sfu path /sfu-signaling/socket.io*
	handle @sfu {
		reverse_proxy audiomonastry:8080 {
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# SFU-Base-Pfad
	@sfubase path /sfu-signaling
	handle @sfubase {
		reverse_proxy audiomonastry:8080 {
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Everything else to the app
	reverse_proxy audiomonastry:8080 {
		transport http {
			read_timeout 5m
			write_timeout 30s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000, includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
		-X-Powered-By
	}
}
