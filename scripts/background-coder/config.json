{
  "pipeline": "background-coder",
  "orchestrator": {
    "name": "DeepSeek V4 Flash Visionary",
    "model": "deepseek-v4-flash",
    "chatUrl": "https://api.deepseek.com/chat/completions",
    "apiKeyEnv": ["DEEPSEEK_API_KEY"],
    "thinking": "max",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "agents": {
    "#2": {
      "name": "Kimi K2.7-Code",
      "model": "kimi-k2.7-code",
      "chatUrl": "https://api.moonshot.cn/v1/chat/completions",
      "apiKeyEnv": ["KIMI_API_KEY", "MOONSHOT_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#3": {
      "name": "GLM-5.3",
      "model": "glm-5.3",
      "chatUrl": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "apiKeyEnv": ["GLM_API_KEY", "ZHIPU_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#4": {
      "name": "Qwen3-Coder-Next",
      "model": "Qwen/Qwen3-Coder-Next",
      "chatUrl": "https://router.huggingface.co/v1/chat/completions",
      "apiKeyEnv": ["HF_API_KEY", "HF_TOKEN"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#5": {
      "name": "GLM-5.3-Flash",
      "model": "glm-5.3-flash",
      "chatUrl": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "apiKeyEnv": ["GLM_API_KEY", "ZHIPU_API_KEY"],
      "temperature": 0.2,
      "maxTokens": 4096
    },
    "#6": {
      "name": "DeepSeek V4 Pro",
      "model": "deepseek-v4-pro",
      "chatUrl": "https://api.deepseek.com/chat/completions",
      "apiKeyEnv": ["DEEPSEEK_API_KEY"],
      "temperature": 0.05,
      "maxTokens": 8192
    }
  },
  "reviewRequiredDomains": ["SECURITY", "COMPLIANCE", "HOTFIX"],
  "reviewAgent": "#6",
  "classLimits": { "LEICHT": 12, "MITTEL": 12, "SCHWER": 12 }
}
