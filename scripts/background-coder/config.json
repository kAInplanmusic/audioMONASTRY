{
  "pipeline": "background-coder",
  "hfRouter": false,
  "directChat": "cerebras",
  "budget": {
    "maxRetries": 3,
    "backoffBaseMs": 1000,
    "maxBackoffMs": 30000,
    "requestTimeoutMs": 120000,
    "taskTimeoutMs": 600000,
    "maxParallel": 2,
    "sessionRequestLimit": 250,
    "dailyRequestLimit": 1500,
    "quotaPauseMs": 600000
  },
  "orchestrator": {
    "name": "Cerebras GPT-OSS-120B (Orchestrator)",
    "model": "gpt-oss-120b",
    "chatUrl": "cerebras",
    "apiKeyEnv": ["CB_API_KEY"],
    "thinking": "max",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "agents": {
    "#2": {
      "name": "Cerebras GPT-OSS-120B",
      "model": "gpt-oss-120b",
      "chatUrl": "cerebras",
      "apiKeyEnv": ["CB_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#3": {
      "name": "GLM-5.3 (HF), Fallback PublicAI",
      "model": "zai-org/GLM-5.3",
      "chatUrl": "publicai",
      "apiKeyEnv": ["PUBLICAI_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#4": {
      "name": "Cerebras GPT-OSS-120B (Code-Eleganz)",
      "model": "gpt-oss-120b",
      "chatUrl": "cerebras",
      "apiKeyEnv": ["CB_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#5": {
      "name": "Cerebras GPT-OSS-120B (Flash)",
      "model": "gpt-oss-120b",
      "chatUrl": "cerebras",
      "apiKeyEnv": ["CB_API_KEY"],
      "temperature": 0.2,
      "maxTokens": 4096
    },
    "#6": {
      "name": "Cerebras GPT-OSS-120B (Final Review)",
      "model": "gpt-oss-120b",
      "chatUrl": "cerebras",
      "apiKeyEnv": ["CB_API_KEY"],
      "temperature": 0.05,
      "maxTokens": 8192
    }
  },
  "reviewRequiredDomains": ["SECURITY", "COMPLIANCE", "HOTFIX"],
  "reviewAgent": "#6",
  "classLimits": { "LEICHT": 12, "MITTEL": 12, "SCHWER": 12 }
