{
  "pipeline": "background-coder",
  "hfRouter": true,
  "budget": {
    "maxRetries": 3,
    "backoffBaseMs": 1000,
    "maxBackoffMs": 30000,
    "requestTimeoutMs": 120000,
    "taskTimeoutMs": 600000,
    "maxParallel": 2,
    "sessionRequestLimit": 250,
    "dailyRequestLimit": 1500,
    "quotaPauseMs": 600000
  },
  "orchestrator": {
    "name": "MoA / DeepSeek V4 Flash Visionary (max thinking)",
    "model": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
    "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
    "thinking": "max",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "agents": {
    "#2": {
      "name": "Kimi K2.7-Code",
      "model": "moonshotai/Kimi-K2.7-Code",
      "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#3": {
      "name": "GLM-5.3",
      "model": "zai-org/GLM-5.3",
      "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#4": {
      "name": "Qwen3-Coder-Next",
      "model": "Qwen/Qwen3-Coder-Next",
      "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
      "temperature": 0.1,
      "maxTokens": 8192
    },
    "#5": {
      "name": "GLM-5.3-Flash",
      "model": "zai-org/GLM-5.3-Flash",
      "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
      "temperature": 0.2,
      "maxTokens": 4096
    },
    "#6": {
      "name": "DeepSeek V4 Pro (Final Review)",
      "model": "deepseek-ai/DeepSeek-V4-Pro",
      "apiKeyEnv": ["HF_TOKEN", "HF_API_KEY"],
      "temperature": 0.05,
      "maxTokens": 8192
    }
  },
  "reviewRequiredDomains": ["SECURITY", "COMPLIANCE", "HOTFIX"],
  "reviewAgent": "#6",
  "classLimits": { "LEICHT": 12, "MITTEL": 12, "SCHWER": 12 }
}
