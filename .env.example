# ============================================================================
# sampleMONK · Dev-Umgebung (.env.example) – Google/Firebase-frei
# ============================================================================

# Lokales Ollama-LLM (optional, für HyperSonicMOA)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1

# Frontend runtime endpoints (LEER lassen für Same-Origin-Default)
VITE_API_BASE_URL=""
VITE_SOCKET_IO_SIGNALING_URL=""
VITE_SIGNALING_WS_URL=""
VITE_SIGNALING_HTTP_URL=""
VITE_SIGNALING_TRANSPORT_URL=""

# Phase 9 – V2 ist der einzige Audiopfad (V1 entfernt)
VITE_V2_AUDIO_MODE="v2"   # einziger gültiger Wert; 'v1' existiert nicht mehr
# VITE_V2_AUDIO_ONLY="1"    # historisch, ohne Wirkung (V1 ist entfernt)

# ============================================================================
# Optionale externe Datenbanken (Supabase + Cloudflare R2)
# ----------------------------------------------------------------------------
# Ohne diese Variablen bleibt die App vollständig offline-fähig (eingebaute
# Presets). Mit gültigen Keys werden Samples/Musik aus Supabase gelesen und
# per Server-API geschrieben; Audio-Blobs landen in Cloudflare R2.
# ============================================================================

# --- Supabase (Sample-/Musik-Datenbank) ---
# SUPABASE_URL=https://xxx.supabase.co
# Anon-/Publishable-Key (RLS-geschützt, landet im Browser-Bundle):
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_PUB=eyJ...  (JWT)  ODER  sb_publishable_...
# Schreibzugriff (Sync/Push) nur serverseitig:
# SUPABASE_SERVICE_ROLE=sb_secret_...

# --- Cloudflare R2 (Objekt-Storage für Audio-Blobs) ---
# CFR2_ACCOUNT_ID=...                  (32 Hex-Zeichen)
# CFR2_ACCESS_KEY_ID=...               (32 Hex-Zeichen)
# CFR2_SECRET_ACCESS_KEY=...           (64 Hex-Zeichen)
# CFR2_BUCKET=audio-monastry-samples
# Optional: abweichender S3-Endpoint (leer lassen für Standard)
# CLOUDFLARE_API=https://<accountid>.r2.cloudflarestorage.com
# VITE_CFR2_ACCOUNT_ID=...  +  VITE_CFR2_BUCKET=...  (nur für R2-Read-URLs im Client)

# ============================================================================
# VoiceMONK: Hugging Face (Stimmen, Gesang, Songs) – NUR serverseitig
# ----------------------------------------------------------------------------
# Der Browser ruft ausschließlich /api/voice/* auf; der Server hält den Key.
# Diese Variablen NIE mit VITE_-Präfix setzen (sonst landen sie im Bundle).
# ============================================================================
# HF_API_KEY=hf_...
# HF_TTS_MODEL=facebook/mms-tts-deu
# HF_BARK_MODEL=suno/bark
# HF_MUSIC_MODEL=facebook/musicgen-medium
# HF_MUSIC_FALLBACK_MODEL=facebook/musicgen-small
# Eigene AI-Runtime für TTS bevorzugen (Custom Container samplemonk-ai):
# VOICE_AI_RUNTIME_URL=https://samplemonk-ai.us-east-1.aws.endpoints.huggingface.cloud
# VOICE_AI_RUNTIME_TTS_MODEL=qwen3-tts-06b   # Apache-2.0, inkl. Deutsch
# VOICE_AI_RUNTIME_SING_MODEL=bark           # Suno Bark (Gesang)
# VOICE_AI_RUNTIME_SONG_MODEL=musicgen-small # MusicGen (Song; Medium via Env möglich)
# SOUND_AI_RUNTIME_MODEL=musicgen-small      # soundMONK via Runtime; alternativ stable-audio-open-1.0
# Stable Audio Open im samplemonk-ai-runtime:
#   docker build --build-arg AI_INSTALL_AUDIO_AI=1 ...
#   Achtung: HF-Gated-Modell – Lizenz/Nutzungsbedingungen müssen akzeptiert sein.
# SONG_AI_RUNTIME_MODEL=musicgen-small       # songMONK-Generierung via Runtime (später ACE-Step/DiffRhythm)
# ACE-Step 1.5 (MIT, Vocal-Songs) als bevorzugter songMONK-Backend:
#   Start: git clone https://github.com/ACE-Step/ACE-Step-1.5 && cd ACE-Step-1.5 && uv sync && uv run acestep-api
# SONG_AI_ACE_STEP_URL=http://localhost:8001
# SONG_AI_ACE_STEP_TOKEN=                    # optional, falls ACESTEP_API_KEY gesetzt ist
# DiffRhythm 2 (Apache-2.0) als zweiter Song-Backend (ACE-Step-kompatibler Wrapper nötig):
# SONG_AI_DIFF_RHYTHM_URL=http://localhost:8002
# SONG_AI_DIFF_RHYTHM_TOKEN=                 # optional

# ============================================================================
# LLM-Router (MOA/MCP-Planung + Automation) – NUR serverseitig
# ----------------------------------------------------------------------------
# Reihenfolge: DeepSeek Flash → HF (kostenlos) → Mistral → Ollama (lokal)
# (20 Req/Tag) → DeepSeek V4 Flash (MOA/MCP-Planer, sehr günstig) →
# DeepSeek V4 Pro (komplex). Gemini/OpenAI sind bezahlt und werden nur bei
# AI_EMERGENCY_PROVIDERS=true als Notfall registriert.
# ============================================================================
# HF_API_KEY=hf_...
# MISTRAL_API_KEY=...            # mistral-small-latest (EU, günstig, Function-Calling)
# MISTRAL_MODEL=mistral-small-latest
# QWEN3_CODER_MODEL=Qwen/Qwen3-Coder-Next   # optional, eigener Code-Spezialist im LlmRouter
# CB_API_KEY=csk-...             # Cerebras – sehr schnelle Inference, Primär-Provider (OpenAI-kompatibel)
# CEREBRAS_MODEL=qwen-3.8-27b    # optional; verfügbar auch: gemma-4-31b, gpt-oss-120b
# OR_API_KEY=sk-or-v1-...        # OpenRouter – bezahlter Multi-Model-Fallback
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OLLAMA_URL=http://localhost:11434   # lokaler MOA/Sprachbefehle/TTS-Fallback
# OLLAMA_MODEL=qwen2.5:7b
# DEEPSEEK_API_KEY=sk-...         # deepseek-v4-flash / deepseek-v4-pro
# GEMINI_API_KEY=...              # NOTFALL (bezahlt)
# OPENAI_API_KEY=sk-...           # NOTFALL (bezahlt, keine Free-API mehr)
# AI_EMERGENCY_PROVIDERS=false    # 'true' registriert Gemini+OpenAI



# Multi-Instanz-Signaling (2+ App-Knoten):
# REDIS_URL=redis://<redis-host>:6379
# SFU_ANNOUNCED_IP=<public-ip>   # nur auf dem SFU-Knoten (docker-compose.sfu.yml)
# SFU_PORTS=40000-40099

# ============================================================================
# RunPod Serverless AI – 3-Rollen-GPU-Flotte (brain | ears | voiceGen)
# ----------------------------------------------------------------------------
# Details: docs/RUNPOD_AI_V1_SPEC.md
#   brain     = lokales LLM (MOA/MCP), ears = Audio-Intelligence,
#   voiceGen  = TTS/Gesang/Song/SFX/Stems.  Je A6000 48 GB (AMPERE_48).
#
# Endpoint-IDs kommen aus dem Deploy (scripts/runpod-deploy.py +
# .github/workflows/runpod-deploy.yml). Fehlt eine Rollen-ID, fällt die Rolle
# auf RUNPOD_ENDPOINT_ID zurück (Legacy-Single-Endpoint, z. B. der alte H200).
# RUNPOD_ENDPOINT_ID_BRAIN=...
# RUNPOD_ENDPOINT_ID_EARS=...
# RUNPOD_ENDPOINT_ID_VOICE=...
# RUNPOD_ENDPOINT_ID=...              # Legacy-Fallback für alle Rollen
# RUNPOD_API_KEY=rp_...               # RunPod API Key (entspricht RP_API_KEY)
# RUNPOD_API_BASE=https://api.runpod.ai/v2
# RUNPOD_REST_BASE=https://rest.runpod.io/v1    # workersMin beim Session-Wake
# RUNPOD_AI_TASK_TIMEOUT_MS=600000
# RUNPOD_WARMUP_TIMEOUT_MS=900000
# --- Brain: vLLM (empfohlen, ~2x kurze Calls / ~3,6x lange Outputs) ----------------
# RUNPOD_BRAIN_OPENAI_URL=https://api.runpod.ai/v2/<BRAIN_ENDPOINT_ID>/openai/v1
# RUNPOD_BRAIN_MODEL=Qwen/Qwen3-14B-AWQ   # serviertes Modell des vLLM-Workers
# --- Brain: eigener Worker (Fallback, zwei Stufen einer Familie) -------------------
# RUNPOD_BRAIN_MODEL=qwen3-14b            # moderate/complex
# RUNPOD_EXECUTOR_MODEL=qwen3-4b          # simple
# AI_FLEET_WAKE=1                     # 0 = Session-Wake komplett aus (kein Netz)
# AI_FLEET_SLEEP=1                    # 0 = workersMin bleibt stehen
# AI_COST_RUNPOD_BRAIN_USD_PER_HOUR=0.39
# AI_COST_RUNPOD_EARS_USD_PER_HOUR=0.39
# AI_COST_RUNPOD_VOICEGEN_USD_PER_HOUR=0.39
# HF_TOKEN bleibt nur für HF-Hub-Modelldownloads (keine HF-Inference mehr)
# ============================================================================

# Stems via Replicate (ENTFÄLLT – wird durch RunPod Stem-Handler ersetzt):
# STEM_AI_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_STEM_MODEL=ryan5453/demucs

# Admin/Root-Debug:
# ADMIN_TOKEN=<langes-zufalls-token>

# ============================================================================
# SECURITY (SEC-F-1/F-5, Server-only – niemals VITE_-Präfix!)
# ============================================================================
# STUDIO_ACCESS_TOKEN: Kern-Auth für ALLE /api/* (außer /health) und den
# Socket.io-Handshake (P-1/P-11). Ohne diesen Token läuft der Server NUR mit
# explizitem Dev-/Test-Modus offen:
#   - Production: immer fail-closed (503), kein stiller Dev-Modus
#   - AUDIOMONASTRY_DEV_NO_AUTH=1: expliziter lokaler Dev-Modus (nur NICHT-Production)
#   - VITEST=true / NODE_ENV=test: Test-Modus
# Generierung: openssl rand -hex 32. Der Portal-Worker (Cloudflare) setzt das
# HttpOnly-Cookie mit demselben Token (siehe .env.portal / docs/PORTAL_SETUP.md).
#STUDIO_ACCESS_TOKEN=<openssl rand -hex 32>
# AUDIOMONASTRY_DEV_NO_AUTH=1  # NUR lokale Entwicklung; in Production wirkungslos
# TRUST_PROXY: Anzahl der Proxy-Hops hinter dem Express-Server (Caddy/Cloudflare).
# Beeinflusst req.ip / Rate-Limit-Keying – falsche Werte = Header-Spoofing-Risiko.
#TRUST_PROXY=1
# SIGNALING_ALLOWED_ORIGINS: Komma-getrennte Origin-Allowlist für den
# Socket.io-Handshake (leer = Origin-Check deaktiviert, nur für lokale Tests).
# Wird in Produktion zusätzlich als API-Origin-Allowlist verwendet (API_ALLOWED_ORIGINS).
#SIGNALING_ALLOWED_ORIGINS=https://anunnakitools.de
# Webhook-/Bot-Secrets (optional, serverseitig):
#DISCORD_WEBHOOK=
#SLACK_WEBHOOK=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Voice-Provider: 'hf' (Default) oder 'replicate' (Serverless-GPU, Pay-per-Use)
# VOICE_PROVIDER=replicate
# REPLICATE_TTS_MODEL=suno-ai/bark
# REPLICATE_BARK_MODEL=suno-ai/bark
# REPLICATE_MUSIC_MODEL=meta/musicgen

# ============================================================================
# AI Orchestrator (RunPod 3-Rollen-Flotte / Supabase)
# ============================================================================
# Alt-HF-Endpoints (samplemonk-ai, -pilot, -clap) sind abgelöst (LEGACY_GPU_ENDPOINTS
# in src/config/aiInfrastructure.ts). Sie dürfen nicht mehr als GPU-Pfad gesetzt
# werden; die AI-Inferenz läuft über die drei RunPod-Rollen (siehe oben).
# HF_TOKEN/HF_API_KEY bleiben nur für HF-Hub-Downloads bzw. als Nicht-GPU-Fallback.
# HF_API_KEY=hf_...

# Orchestrator-Limits:
# AI_MAX_GPU_ENDPOINTS=3             # HARTE KOSTENREGEL: max. 1 pro Flotten-Rolle (brain|ears|voiceGen)
# AI_SESSION_IDLE_TIMEOUT=1200000    # 20 min bis Session-Wake-Rücknahme (ms)
# AI_MAX_VRAM=48                     # VRAM-Budget je Rollen-Endpoint (GB)
# AI_MAX_CONCURRENCY_STEMS=2
# AI_MAX_CONCURRENCY_GENERATION=1
# AI_TIMEOUT_MS=120000               # Default-Timeout für AI-Jobs (ms)
# AI_WAKE_TIMEOUT_MS=300000          # Kaltstart-Budget Scale-to-Zero (ms)
# AI_ALLOW_EXTERNAL_LLM=false        # ohne true ist das lokale Brain der einzige LLM-Provider
# AI_INCLUDE_PLANNED=0               # 1 = Manifest-Modelle mit status="planned" mitladen (nur Benchmarks)
# AI_RUNTIME_DEBUG=0                 # 1 = echte Fehlermeldung an Worker-Fehler anhaengen (nur Diagnose)
# AI_LOG_LEVEL=INFO

# Kostensätze (USD, Preisquellen in src/core/ai/orchestrator/costTracker.ts):
# AI_COST_A100_USD_PER_HOUR=2.5
# AI_COST_CPU_USD_PER_HOUR=0.033
# AI_COST_STEM_USD=0.05
# AI_GPU_TYPE=A100

# Stem-ai (D22): URL wird pro Request ausgelesen – Tests/Deploys können sie
# überschreiben; Provider-Ausfall liefert schnellen 502.
# STEM_AI_URL=http://stem-ai:8000
# STEM_AI_PROVIDER=fallback        # fallback | replicate | stem-ai
# ENABLE_STEMS=0

# DevSettings „AI Server Shutdown“ (D15): Wenn aktiv, werden AI-Provider
# gestoppt und vorhandene Fallbacks (Lokal/Deterministisch) automatisch genutzt.
# AI_SERVER_SHUTDOWN=0

# PublicAI (optionaler OpenAI-kompatibler Provider)
PUBLICAI_KEY=
PUBLICAI_BASE_URL=https://api.publicai.co/v1
PUBLICAI_MODEL=swiss-ai/apertus-v1.5-70b-thinking

# ONNX-Modell-Pfade
# Optional: alternative Pfad für htdemucs (Standard: public/models/htdemucs/htdemucs.onnx)
ONNX_MODEL_PATH=/public/models/htdemucs/htdemucs.onnx
# RUNPOD_ENDPOINT_ID_VISION=...   # Rolle vision (FLUX.1-dev, /runprompt -> Bild)
