# ============================================================================
# sampleMONK · Dev-Umgebung (.env.example) – Google/Firebase-frei
# ============================================================================

# Lokales Ollama-LLM (optional, für HyperSonicMOA)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1

# Frontend runtime endpoints (LEER lassen für Same-Origin-Default)
VITE_API_BASE_URL=""
VITE_SOCKET_IO_SIGNALING_URL=""
VITE_SIGNALING_WS_URL=""
VITE_SIGNALING_HTTP_URL=""
VITE_SIGNALING_TRANSPORT_URL=""

# ============================================================================
# Optionale externe Datenbanken (Supabase + Cloudflare R2)
# ----------------------------------------------------------------------------
# Ohne diese Variablen bleibt die App vollständig offline-fähig (eingebaute
# Presets). Mit gültigen Keys werden Samples/Musik aus Supabase gelesen und
# per Server-API geschrieben; Audio-Blobs landen in Cloudflare R2.
# ============================================================================

# --- Supabase (Sample-/Musik-Datenbank) ---
# SUPABASE_URL=https://xxx.supabase.co
# Anon-/Publishable-Key (RLS-geschützt, landet im Browser-Bundle):
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_PUB=eyJ...  (JWT)  ODER  sb_publishable_...
# Schreibzugriff (Sync/Push) nur serverseitig:
# SUPABASE_SERVICE_ROLE=sb_secret_...

# --- Cloudflare R2 (Objekt-Storage für Audio-Blobs) ---
# CFR2_ACCOUNT_ID=...                  (32 Hex-Zeichen)
# CFR2_ACCESS_KEY_ID=...               (32 Hex-Zeichen)
# CFR2_SECRET_ACCESS_KEY=...           (64 Hex-Zeichen)
# CFR2_BUCKET=audio-monastry-samples
# Optional: abweichender S3-Endpoint (leer lassen für Standard)
# CLOUDFLARE_API=https://<accountid>.r2.cloudflarestorage.com
# VITE_CFR2_ACCOUNT_ID=...  +  VITE_CFR2_BUCKET=...  (nur für R2-Read-URLs im Client)

# ============================================================================
# VoiceMONK: Hugging Face (Stimmen, Gesang, Songs) – NUR serverseitig
# ----------------------------------------------------------------------------
# Der Browser ruft ausschließlich /api/voice/* auf; der Server hält den Key.
# Diese Variablen NIE mit VITE_-Präfix setzen (sonst landen sie im Bundle).
# ============================================================================
# HF_API_KEY=hf_...
# HF_TTS_MODEL=facebook/mms-tts-deu
# HF_BARK_MODEL=suno/bark
# HF_MUSIC_MODEL=facebook/musicgen-medium
# HF_MUSIC_FALLBACK_MODEL=facebook/musicgen-small
# Eigene AI-Runtime für TTS bevorzugen (Custom Container samplemonk-ai):
# VOICE_AI_RUNTIME_URL=https://samplemonk-ai.us-east-1.aws.endpoints.huggingface.cloud
# VOICE_AI_RUNTIME_TTS_MODEL=qwen3-tts-06b   # Apache-2.0, inkl. Deutsch
# VOICE_AI_RUNTIME_SING_MODEL=bark           # Suno Bark (Gesang)
# VOICE_AI_RUNTIME_SONG_MODEL=musicgen-small # MusicGen (Song; Medium via Env möglich)
# SOUND_AI_RUNTIME_MODEL=musicgen-small      # soundMONK-KI-Generierung via Runtime
# SONG_AI_RUNTIME_MODEL=musicgen-small       # songMONK-Generierung via Runtime (später ACE-Step/DiffRhythm)

# ============================================================================
# LLM-Router (MOA/MCP-Planung + Automation) – NUR serverseitig
# ----------------------------------------------------------------------------
# Reihenfolge: DeepSeek Flash → HF (kostenlos) → Mistral → Ollama (lokal)
# (20 Req/Tag) → DeepSeek V4 Flash (MOA/MCP-Planer, sehr günstig) →
# DeepSeek V4 Pro (komplex). Gemini/OpenAI sind bezahlt und werden nur bei
# AI_EMERGENCY_PROVIDERS=true als Notfall registriert.
# ============================================================================
# HF_API_KEY=hf_...
# MISTRAL_API_KEY=...            # mistral-small-latest (EU, günstig, Function-Calling)
# MISTRAL_MODEL=mistral-small-latest
# QWEN3_CODER_MODEL=Qwen/Qwen3-Coder-Next   # optional, eigener Code-Spezialist im LlmRouter
# OLLAMA_URL=http://localhost:11434   # lokaler MOA/Sprachbefehle/TTS-Fallback
# OLLAMA_MODEL=qwen2.5:7b
# DEEPSEEK_API_KEY=sk-...         # deepseek-v4-flash / deepseek-v4-pro
# GEMINI_API_KEY=...              # NOTFALL (bezahlt)
# OPENAI_API_KEY=sk-...           # NOTFALL (bezahlt, keine Free-API mehr)
# AI_EMERGENCY_PROVIDERS=false    # 'true' registriert Gemini+OpenAI



# Multi-Instanz-Signaling (2+ App-Knoten):
# REDIS_URL=redis://<redis-host>:6379
# SFU_ANNOUNCED_IP=<public-ip>   # nur auf dem SFU-Knoten (docker-compose.sfu.yml)
# SFU_PORTS=40000-40099

# Stems via Replicate (Pay-per-Use GPU, ~3-5 Cent/Song):
# STEM_AI_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_STEM_MODEL=ryan5453/demucs

# Admin/Root-Debug:
# ADMIN_TOKEN=<langes-zufalls-token>

# Voice-Provider: 'hf' (Default) oder 'replicate' (Serverless-GPU, Pay-per-Use)
# VOICE_PROVIDER=replicate
# REPLICATE_TTS_MODEL=suno-ai/bark
# REPLICATE_BARK_MODEL=suno-ai/bark
# REPLICATE_MUSIC_MODEL=meta/musicgen

# ============================================================================
# AI Orchestrator (Hetzner ↔ Hugging Face Endpoint / Replicate / Supabase)
# ============================================================================
# Dedizierter HF-Endpoint (Custom Container services/samplemonk-ai-runtime):
# GPU-KONSOLIDIERUNG: Maximal EIN GPU-Endpoint (samplemonk-ai) ist erlaubt.
# Alle Modelle (Whisper, CLAP, AST, MusicGen, TTS/Bark, Qwen-Omni) laufen über
# diesen einen A100-Endpoint. HF_PILOT_ENDPOINT_URL/HF_CLAP_ENDPOINT_URL sind
# DEAKTIVIERT und dürfen nicht mehr gesetzt werden.
# HF_ENDPOINT_NAME=samplemonk-ai
# HF_ENDPOINT_URL=https://<endpoint-name>.us-east-1.aws.endpoints.huggingface.cloud
# HF_TOKEN=hf_...            # Hub-Token für Gewichte + Endpoint-Auth (ersetzt HF_API_KEY dort)
# HF_API_KEY=hf_...          # Serverless-Inference (bestehend, LLM/Voice-Fallback)

# Orchestrator-Limits:
# AI_MAX_GPU_ENDPOINTS=1             # HARTE KOSTENREGEL: immer 1 (nie > 1 A100)
# AI_SESSION_IDLE_TIMEOUT=1200000    # 20 min bis Scale-to-Zero-Anforderung (ms)
# AI_MAX_VRAM=80                     # VRAM-Budget des Endpoints (GB)
# AI_MAX_CONCURRENCY_STEMS=2
# AI_MAX_CONCURRENCY_GENERATION=1
# AI_TIMEOUT_MS=120000               # Default-Timeout für AI-Jobs (ms)
# AI_WAKE_TIMEOUT_MS=300000          # Kaltstart-Budget Scale-to-Zero (ms)
# AI_LOG_LEVEL=INFO

# Kostensätze (USD, Preisquellen in src/core/ai/orchestrator/costTracker.ts):
# AI_COST_A100_USD_PER_HOUR=2.5
# AI_COST_CPU_USD_PER_HOUR=0.033
# AI_COST_STEM_USD=0.05
# AI_GPU_TYPE=A100

# Stem-ai (D22): URL wird pro Request ausgelesen – Tests/Deploys können sie
# überschreiben; Provider-Ausfall liefert schnellen 502.
# STEM_AI_URL=http://stem-ai:8000
# STEM_AI_PROVIDER=fallback        # fallback | replicate | stem-ai
# ENABLE_STEMS=0

# DevSettings „AI Server Shutdown“ (D15): Wenn aktiv, werden AI-Provider
# gestoppt und vorhandene Fallbacks (Lokal/Deterministisch) automatisch genutzt.
# AI_SERVER_SHUTDOWN=0
