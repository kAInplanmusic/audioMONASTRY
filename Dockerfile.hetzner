# =============================================================================
# audioMONASTRY · Dockerfile.hetzner  (high-end production image)
# -----------------------------------------------------------------------------
# Optimiert fuer Hetzner Cloud VPS (stuendlich abgerechnet):
#   - nutzt das VOR-KOMPILIERTE native Mixer-Modul (services/mixer/*.node)
#     statt den Rust-Mixer im Build neu zu kompilieren → schneller, robuster.
#   - serviert die App + REST API + WebRTC-Signaling in EINEM Container/Port.
#   - Multi-Stage: Builder (npm ci + vite/esbuild) → schlanke Runtime.
#   - tini als PID 1 (Zombie-Reaping, saubere Signal-Weiterleitung).
#   - Non-root User, OCI-Labels, Healthcheck.
#
# Build:  docker build -f Dockerfile.hetzner -t audiomonastry:hetzner .
# =============================================================================
FROM node:22-slim AS builder
WORKDIR /app

# libatomic1 wird vom mediasoup-worker-Prebuild benoetigt (postinstall).
# python3/make/g++ sind noetig, wenn der mediasoup-Prebuild im Container NICHT
# laeuft (Kernel/glibc-Abweichung) und der Worker lokal gebaut werden muss –
# genau daran ist der Hetzner-App-Deploy am 2026-09-11 gescheitert
# ("/bin/sh: 1: python: not found").
RUN apt-get update && apt-get install -y --no-install-recommends \
        libatomic1 python3 python3-pip make g++ \
    && rm -rf /var/lib/apt/lists/*

# Nur package.json/lock zuerst kopieren (besseres Layer-Caching)
COPY package.json ./
COPY package-lock.json ./
# NOSONAR: Lifecycle-Skripte (mediasoup/esbuild) werden für den Build benötigt
RUN npm ci --no-audit --no-fund

COPY . .
# Build + Prod-Deps in EINEM Layer (spart Image-Groesse):
#   npm prune --omit=dev entfernt Dev-Dependencies (esbuild/tsc/…),
#   mediasoup/socket.io/tone bleiben als Runtime-Dependencies erhalten.
RUN npm run build \
    && npm prune --omit=dev \
    && npm cache clean --force

# =============================================================================
FROM node:22-slim
WORKDIR /app

# OCI-Labels (OCI Image Format Spec)
LABEL org.opencontainers.image.title="audioMONASTRY" \
      org.opencontainers.image.description="audioMONASTRY Pro Audio Workstation – App, REST API, WebRTC-Signaling" \
      org.opencontainers.image.source="https://github.com/kAInplanmusic/audioMONASTRY" \
      org.opencontainers.image.vendor="monkMONASTRY" \
      org.opencontainers.image.licenses="UNLICENSED"

ENV NODE_ENV=production \
    PORT=8080 \
    NODE_OPTIONS="--enable-source-maps"

# Laufzeit benoetigt: libatomic1 (mediasoup-worker), tini (PID 1),
# ca-certificates (ausgehende HTTPS-Calls zu HF/DeepSeek/Mistral/Supabase/R2),
# ffmpeg (VisualMONK #5: Show-Merge mehrerer Clips zu einem mp4).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libatomic1 \
    tini \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Gebautes Frontend + gebuendeltes Server-Bundle.
# Wichtig: `--chown=node:node` direkt beim COPY statt eines spaeteren
# `chown -R` - der rekursive Lauf musste auf overlayfs jede der ~50k Dateien
# (305 MB node_modules) kopieren und brauchte im Deploy-Drill 2026-09-17 ueber
# 20 Minuten (einheitliche Besitzrechte, aber ohne zweiten Durchlauf).
COPY --chown=node:node --from=builder /app/dist ./dist

# Services (z. B. vorkompilierter Mixer) + node_modules (inkl. mediasoup/socket.io)
COPY --chown=node:node --from=builder /app/services ./services
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/package.json ./

# Nicht-root Nutzer (node:22-slim bringt den User "node" mit). Das App-Root
# bleibt beschreibbar (z. B. VISION_ARTIFACT_DIR unter /app) - ohne Rekursion.
RUN chown node:node /app

# PROD-P0-003: Build-Version im Image (deploy.sh uebergibt sie aus package.json).
# Sie ist ein ENV im Runtime-Stage und damit von aussen pruefbar
# (/api/health -> version) - genau das macht einen Rollback nachweisbar.
# Bewusst ERST HIER (nach copy/chown): ein reiner Versionswechsel invalidiert
# dadurch nur diese letzten Layer. Stand er vor dem apt-Layer, baute ein
# DEPLOY_VERSION-Wechsel im Drill 2026-09-17 den kompletten Stage neu.
ARG BUILD_VERSION=dev
ENV AUDIOMONASTRY_VERSION=$BUILD_VERSION

USER node

EXPOSE 8080

# Healthcheck direkt im Image (wird von docker-compose zusätzlich überwacht)
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# tini als PID 1, danach npm start (node dist/server.cjs)
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "start"]
