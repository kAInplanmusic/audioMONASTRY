# ============================================================================
#  audioMONASTRY · Hetzner Deployment (.env.hetzner.example) – Google/Firebase-frei
# ----------------------------------------------------------------------------
#  Kopiere diese Datei als `.env` und fülle die Platzhalter:
#      cp .env.hetzner.example .env
#  Hinweis: Der Server benötigt KEINE Google-/Firebase-Zugangsdaten mehr.
#  Alle Daten werden lokal (Dateisystem/Browser) gehalten.
# ============================================================================

# --- Laufzeit (Server) ---
PORT=8080
NODE_ENV=production

# --- STUDIO-ACCESS-TOKEN (PFLICHT in Produktion, ARCH-SEC-001) ---------------
# Production ist fail-closed: Fehlt dieser Token, antwortet die API (außer
# /api/health) mit 503 STUDIO_TOKEN_MISSING und WebRTC-Signaling wird abgelehnt.
# Erzeugen mit:  openssl rand -hex 32
#STUDIO_ACCESS_TOKEN=<32-byte-hex-token-hier-einfuegen>

# --- Idle-Auto-Shutdown (PROD-P3-F9): systemd-Timer auf den Knoten -----------
# Der Timer fragt GET /api/idle-signal DIREKT auf dem App-Port (nicht ueber
# Caddy/Port 80 - Klartext-http bekommt dort 308) und schickt nur seine
# Host-Fakten mit; die Entscheidung (idle / Shutdown) faellt in der App
# (server/idleSignal.ts). Unlesbares Signal (kein 200) = fail-safe: kein Shutdown.
# Idle nur, wenn KEINE Socket-Clients UND keine offenen Sockets/SSH/Load/
# Container-Jobs UND kein erfolgreicher App-Request seit der Schwelle.
# Installation:  sudo bash scripts/hetzner/install-idle-shutdown.sh
#   (bring-up-fleet.sh Schritt 7 macht das auf allen Knoten; der Portal-Wake auf
#    app-1. Ohne Token bricht der Installer ab - er waere sonst strukturell blind.)
#SCRAPE_TOKEN=<16+-zeichen-token>          # Maschinen-Client des Timers (x-scrape-token)
#IDLE_SHUTDOWN_MINUTES=30                  # App-Fallback-Schwelle, wenn der Timer keine schickt
#IDLE_MINUTES=30                           # Schwelle des Timers (geht als thresholdSec an die App)
#CHECK_INTERVAL=5                          # Pruefintervall des Timers in Minuten
#IDLE_CHECK_URL=http://127.0.0.1:8080/api/idle-signal   # Ziel: App-Port, NICHT Port 80

# --- Domain für HTTPS (Caddy). Pflicht für iPhone/iPad-Mikrofon.
#     A/AAAA-Record der Domain muss auf die Hetzner-IP zeigen.
#     Für reinen IP-Test leer lassen (dann http://IP, kein iOS-Mikrofon). ---
DOMAIN=deine-domain.example

# --- WebRTC Signaling (läuft im selben Prozess auf :8080) ---
SIGNALING_IDLE_TIMEOUT_MS=1200000
SIGNALING_ALLOWED_ORIGINS=

# --- Optional: Backend-Core über eigene URL (nur bei getrenntem Service) ---
BACKEND_CORE_URL=

# --- Optional: Lokales Ollama-LLM (für HyperSonicMOA, falls genutzt) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1

# ----------------------------------------------------------------------------
#  Build-Zeit Variablen (NUR setzen, wenn das Backend auf einem ANDEREN Host läuft)
#  Bei Same-Origin-Deployment auf Hetzner: ALLE leer lassen.
# ----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://deine-domain.example
# VITE_SOCKET_IO_SIGNALING_URL=https://deine-domain.example
# VITE_SIGNALING_WS_URL=
# VITE_SIGNALING_HTTP_URL=
# VITE_SIGNALING_TRANSPORT_URL=

# (Optional) Echte Demucs-Stem-Separation aktivieren (benötigt Python + torchaudio).
# ENABLE_STEMS=1

# (Optional) Nativer Mixing/Mastering-Dienst (FFmpeg+NumPy), siehe docker-compose.yml.
# server.ts reicht /api/master/* an diese URL weiter.
# MASTER_PLAYER_URL=http://master-player:8000

# ----------------------------------------------------------------------------
#  Upload + externe Datenbanken (Supabase + Cloudflare R2)
#  Pflicht für: Sample-Upload, Cloud-Bibliothek, Sync.
#  Anleitung: docs/HETZNER_DEPLOY.md
# ----------------------------------------------------------------------------
UPLOAD_MAX_MB=100
MASTER_PLAYER_URL=http://master-player:8000

# Supabase (Metadaten-Datenbank) – service_role NUR serverseitig!
SB_URL=https://<project-ref>.supabase.co
SB_SERVICE_ROLE=<service-role-key>
SB_PUBLISHABLE=<sb_publishable_…>
# Client-Varianten werden beim Build in das Frontend gebacken (PUBLIC keys only!)
VITE_SB_URL=https://<project-ref>.supabase.co
VITE_SB_ANON_PUB=<anon-key>

# Cloudflare R2 (Audio-Blob-Speicher, S3-API)
CFR2_ACCOUNT_ID=<cloudflare-account-id>
CFS3_ACCESS_KEY=<r2-access-key-id>
CFS3_SECRET_KEY=<r2-secret-access-key>
CFS3_BUCKET=audiomonastrysamples
# Client-Varianten für R2-Public-Read-URLs (beim Build eingebacken)
VITE_CFR2_ACCOUNT_ID=...
VITE_CFS3_BUCKET=audiomonastrysamples
# Oeffentliche R2-URL (R2 > Settings > Public Access, z.B. https://pub-xxxx.r2.dev)
# CFR2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Multi-Instanz-Signaling (2+ App-Knoten):
# REDIS_URL=redis://<redis-host>:6379
#
# --- SFU + TURN (F6) ---------------------------------------------------------
# Auf sfu-1 setzt `scripts/hetzner/wire-rtc.sh sfu` diese Werte selbst
# (oeffentliche IP zur Laufzeit); auf app-1 `wire-rtc.sh app` (mit
# SFU_PUBLIC_IP=<sfu-1-ip>). Hier stehen sie zur Dokumentation - Werte, die man
# ausnahmsweise von Hand setzt, ueberschreiben die Skripte:
#
# ENABLE_SFU=1                       # nur auf dem SFU-Knoten; app-1 bleibt 0
# SFU_ANNOUNCED_IP=<public-ip>       # nur auf dem SFU-Knoten (docker-compose.sfu.yml)
# SFU_PORTS=40000-40099
# SFU_SIGNALING_PATH=/sfu-signaling
# SFU_SIGNALING_URL=https://sfu.<domain>   # Basis-URL fuer die Clients (HTTPS -> kein Mixed Content)
# TURN_URLS=turn:<sfu-ip>:3478?transport=udp,turn:<sfu-ip>:3478?transport=tcp
# TURN_STATIC_AUTH_SECRET=<openssl rand -hex 32>   # NIE einchecken, nur Knoten-.env
# TURN_TTL_SECONDS=3600
# TURN_REALM=anunnakitools.de

# Stems via Replicate (Pay-per-Use GPU, ~3-5 Cent/Song):
# STEM_AI_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_STEM_MODEL=ryan5453/demucs

# Voice-Provider: 'hf' (Default) oder 'replicate' (Serverless-GPU, Pay-per-Use)
# VOICE_PROVIDER=replicate
# REPLICATE_TTS_MODEL=suno-ai/bark
# REPLICATE_BARK_MODEL=suno-ai/bark

# Admin/Root-Debug (immer setzen!):
# ADMIN_TOKEN=<langes-zufalls-token>

# Observability (docker-compose.monitoring.yml):
# GF_SECURITY_ADMIN_PASSWORD=bitte-aendern
# GF_SERVER_ROOT_URL=https://deine-domain.example/grafana
