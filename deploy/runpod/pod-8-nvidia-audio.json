{
  "pod": {
    "role": "ai-gen",
    "label": "NVIDIA AI-Generator: AudioCraft, MusicFlamingo, DJ-AI, Voice-to-MIDI",
    "aiRole": "music+audio-gen",
    "startTrigger": "always",
    "models": [
      "nvidia/music-flamingo-hf",
      "facebook/musicgen-medium",
      "facebook/musicgen-large",
      "nateraw/musicgen-songstarter-v0.1"
    ],
    "gpuPool": "24gb-nvenc",
    "gpuPoolId": "NVIDIA GeForce RTX 4090",
    "containerDiskGb": 80,
    "covers": [
      "musicGen",
      "djAi",
      "audioGen"
    ],
    "secretEnv": [
      "HF_TOKEN"
    ],
    "target": {
      "models": [
        "nvidia/music-flamingo-hf",
        "facebook/musicgen-medium",
        "facebook/musicgen-large",
        "facebook/musicgen-small",
        "nateraw/musicgen-songstarter-v0.1"
      ],
      "vramGb": 20,
      "params": {
        "dtype": "bf16",
        "audioGenModels": "Dynamic loading from HuggingFace",
        "djAiFeatures": {
          "beatmatch": true,
          "harmonicMix": true,
          "keyDetection": true,
          "djMixGeneration": true
        }
      },
      "retireAfter": {},
      "note": "8. Pod für NVIDIA-Audio-Generierung (aktivierbar via AI_8TH_POD=1). Platz fuer MusicFlamingo (~4GB), MusicGen (~8GB), und DJ-AI Features. Cost: ~0,34 $/h (RTX 4090)."
    },
    "startOrder": 6
  },
  "activation": {
    "envVar": "AI_8TH_POD_ENABLED",
    "default": false,
    "note": "Setze AI_8TH_POD_ENABLED=true in .env um den 8. Pod zu aktivieren"
  },
  "tasks": [
    "audio.generate",
    "music.gen",
    "dj.mix"
  ]
}