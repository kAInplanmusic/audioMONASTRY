{
  "$comment": "Einzige ausführbare RunPod-Konfiguration, SSOT 2026-11-09: 7 KI-Pods + 1 visPod. NVIDIA A40 48 GB pro Instanz, 42 GB Nutzbudget je Pod. docs/RUNPOD_FLEET_SSOT.md",
  "$commentModels": "pods[].models ist die einzige ausgewaehlte residente Gewichtszuordnung; keine weiteren target/ai-gen/alternative GPU-Konfigurationen. Pin und Modellparameter im model_manifest.json.",
  "schemaVersion": 2,
  "namePrefix": "audiomonastry-pod-",
  "imageEnv": "RP_POD_IMAGE",
  "imageExample": "ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:<git-sha>",
  "port": 8000,
  "cloudType": "COMMUNITY",
  "budget": {
    "maxEurPerHour": 6,
    "usdToEur": 0.92,
    "maxUsdPerHourPerInstance": 1,
    "allowedGpus": [
      "NVIDIA A40"
    ]
  },
  "gpuPools": {
    "48gb": [
      {
        "id": "NVIDIA A40",
        "usdPerHour": 0.35
      }
    ]
  },
  "weights": {
    "$comment": "Gewichte liegen als tar je Modell im R2-Bucket unter <prefix>/<model-id>/<revision>.tar mit <prefix>/<model-id>/<revision>.sha256; befuellt von scripts/weights-mirror.py. Der Pod bekommt nur zeitlich begrenzte Presigned-URLs.",
    "prefix": "weights",
    "urlTtlSeconds": 21600
  },
  "pods": [
    {
      "role": "brain",
      "label": "Gehirn: App-/DAW-Steuerung per Text, Tool-Calls, MoA-Planung",
      "aiRole": "brain+orchestrator",
      "startTrigger": "always",
      "models": [
        "qwen3-30b-a3b-awq",
        "qwen3-4b"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 120,
      "covers": [
        "brain",
        "orchestrator"
      ],
      "env": {
        "MOA_CLASSIFIER_MODEL": "qwen3-4b",
        "MOA_PLANNER_A_MODEL": "qwen3-30b-a3b-awq",
        "MOA_PLANNER_B_MODEL": "qwen3-4b",
        "MOA_AGGREGATOR_MODEL": "qwen3-30b-a3b-awq"
      },
      "startOrder": 1,
      "vramSafetyMarginGb": 6
    },
    {
      "role": "ears",
      "label": "Analyse: Sprache, Klang, Musikverstaendnis, Sprecher, Messwerte",
      "aiRole": "ears",
      "startTrigger": "always",
      "models": [
        "whisper-large-v3",
        "clap-music",
        "mert-v2-330m",
        "qwen2-audio-7b",
        "pyannote-diarization",
        "ast-audioset",
        "essentia"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 120,
      "covers": [
        "ears"
      ],
      "secretEnv": [
        "HF_TOKEN"
      ],
      "startOrder": 2,
      "vramSafetyMarginGb": 6
    },
    {
      "role": "voice",
      "label": "Sprache + Geraeusche + LEGO: TTS, Stimmdesign, SFX, ACE-Step xl-base",
      "aiRole": "voiceGen",
      "startTrigger": "always",
      "models": [
        "qwen3-tts-17b",
        "qwen3-tts-voicedesign",
        "qwen3-tts-06b-base",
        "moss-soundeffect-v2.0",
        "acestep-v15-xl-base",
        "acestep-v15-shared"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 120,
      "covers": [
        "voiceGen"
      ],
      "secretEnv": [
        "HF_TOKEN"
      ],
      "startOrder": 3,
      "vramSafetyMarginGb": 6
    },
    {
      "role": "music",
      "label": "Musik, Remix, Drop/Uebergang: ACE-Step 1.5 (mit NVIDIA Music Flamingo Ersatz)",
      "aiRole": "music",
      "startTrigger": "always",
      "models": [
        "acestep-v15-xl-sft",
        "acestep-v15-xl-turbo",
        "acestep-5hz-lm-4b",
        "acestep-v15-shared"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 150,
      "covers": [
        "music"
      ],
      "startOrder": 4,
      "vramSafetyMarginGb": 6
    },
    {
      "role": "studio",
      "label": "Postproduktion + Stem-Trennung: Mastering, Reparatur, Voice-Conversion, Super-Res, 6-Stem-Split",
      "aiRole": "studio+voiceGen",
      "startTrigger": "always",
      "models": [
        "sonicmaster",
        "meanvc2",
        "universr",
        "scnet-xl-4stem",
        "bs-roformer-sw-6stem",
        "htdemucs-6s"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 120,
      "covers": [],
      "startOrder": 5,
      "tasks": [
        "stem.separate"
      ],
      "vramSafetyMarginGb": 6
    },
    {
      "role": "audio-brain",
      "label": "Audio-LLM: Qwen3-Omni + Music Flamingo (Musik-Reasoning, Critique)",
      "aiRole": "audioBrain",
      "startTrigger": "always",
      "models": [
        "qwen3-omni-30b"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 150,
      "covers": [],
      "startOrder": 6,
      "vramSafetyMarginGb": 6
    },
    {
      "role": "song",
      "label": "Song-Generierung: YuE2 (Frontier-Qualitaet, besser als Suno v6)",
      "aiRole": "song",
      "startTrigger": "always",
      "models": [
        "yue2-3b",
        "music-flamingo"
      ],
      "gpuPool": "48gb",
      "gpuPoolId": "NVIDIA A40",
      "containerDiskGb": 120,
      "covers": [],
      "startOrder": 7,
      "vramSafetyMarginGb": 6
    }
  ],
  "visPod": {
    "role": "vis",
    "label": "Vis-Instanz: rendert Visuals auf GPU (NVENC) und streamt zu /visual-out",
    "enabled": true,
    "enabledNote": "Achter Pod: A40 48 GB, Wiedergabe und Streaming vorhandener Visuals (NVENC), keine generativen Modellgewichte.",
    "aiRole": "vis",
    "startTrigger": "always",
    "models": [],
    "gpuPool": "48gb",
    "gpuPoolId": "NVIDIA A40",
    "containerDiskGb": 120,
    "imageEnv": "RP_VIS_IMAGE",
    "estimatedVRAM": 8,
    "vramSafetyMarginGb": 6
  },
  "retiredRoles": [
    "audio-gen",
    "imageHq",
    "videoReal",
    "videoAbstract"
  ]
}
