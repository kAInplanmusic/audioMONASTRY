{
  "name": "audioMONASTRY",
  "private": true,
  "version": "1.210.001",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node build-worklets.mjs && node scripts/build-public-assets.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "security": "node scripts/npm-audit.mjs && node scripts/validate-interface-boundaries.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=.vitest-report.json && node scripts/assert-no-skipped-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "test:parity": "vitest run tests/v2Parity.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test tests/e2e/responsive.spec.ts --config=playwright.responsive.config.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:stress": "playwright test tests/e2e/stress.spec.ts",
    "stress:hetzner": "node scripts/hetzner/stress-test.mjs",
    "stress:sfu": "node scripts/hetzner/sfu-stress-test.mjs",
    "stress:sfu-rtp": "node scripts/hetzner/sfu-rtp-run.mjs",
    "stress:sfu-rtp-multi": "node scripts/hetzner/sfu-rtp-multi-run.mjs",
    "build:sfu-test": "esbuild scripts/hetzner/sfu-rtp-entry.js --bundle --platform=browser --format=iife --outfile=public/sfu-rtp-test.js",
    "build:wasm-hrtf": "cd src/audio/wasm/hrtf_conv && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/hrtf_conv.wasm ../../../../public/hrtf/hrtf_conv.wasm",
    "generate:golden": "tsx scripts/generate-golden-wav.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:deadcode": "knip",
    "check:deadfiles": "knip --include files,dependencies --no-config-hints",
    "check:dupes": "jscpd --reporters consoleFull --min-tokens 100 src server services scripts",
    "check:memo": "node scripts/check-react-memo.mjs",
    "check:memory": "node --expose-gc scripts/memory-pressure-gate.mjs",
    "audit:deep": "tsx scripts/deep-audit/run.ts --mode full --update-todo",
    "audit:deep:diff": "tsx scripts/deep-audit/run.ts --mode diff",
    "audit:deep:static": "tsx scripts/deep-audit/run.ts --mode full --offline",
    "audit:deep:smoke": "tsx scripts/deep-audit/run.ts --mode files --files server.ts src/context/PluginManagerContext.tsx --smoke",
    "audit:deep:help": "tsx scripts/deep-audit/run.ts --help",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "iterate:prompts": "tsx scripts/iterate-prompts.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:python && npm run security && npm run audio:gate && npm run test:rls && npm run check:deadfiles && npm run audit:deep:static",
    "verify:boundary": "node scripts/validate-interface-boundaries.mjs",
    "runpod:smoke": "python3 scripts/runpod-smoke.py",
    "ghcr:check": "python3 scripts/ghcr-check.py",
    "lora:diagnose": "python3 scripts/visual-lora-curate.py --diagnose",
    "lora:curate": "python3 scripts/visual-lora-curate.py",
    "lora:dataset": "python3 scripts/visual-lora-dataset.py",
    "lora:plan": "python3 scripts/runpod-lora-train.py --plan",
    "lora:train": "python3 scripts/runpod-lora-train.py --train",
    "supabase:seed-embeddings": "tsx scripts/seed-sample-embeddings.ts",
    "supabase:index-audio-embeddings": "tsx scripts/index-sample-audio-embeddings.ts",
    "supabase:apply": "tsx scripts/apply-supabase-migrations.ts",
    "supabase:verify": "tsx scripts/verify-supabase.ts",
    "r2:check": "tsx scripts/cloud/r2-health-check.ts",
    "download:orchestral": "node scripts/download-orchestral.mjs",
    "fleet:stop": "bash scripts/hetzner/lifecycle.sh stop",
    "fleet:stop:yes": "bash scripts/hetzner/lifecycle.sh stop --yes",
    "fleet:start": "bash scripts/hetzner/lifecycle.sh start",
    "test:audio-gate": "node scripts/audio-gate.cjs",
    "test:python:deploy": "python3 tests/test_runpod_deploy_defaults.py",
    "test:python:warm": "python3 tests/test_runpod_warm.py",
    "test:python:lora": "python3 tests/test_visual_lora_pipeline.py",
    "test:python:fleet": "python3 tests/test_hetzner_scripts.py",
    "test:python:services": "python3 tests/test_stem_ai_import.py",
    "test:python:master": "python3 tests/test_master_player_limits.py",
    "test:python:guard": "python3 tests/test_runpod_health_guard.py",
    "test:python:runtime": "python3 -m unittest discover -s services/audiomonastry-ai-runtime/tests -p 'test_*.py'",
    "test:python": "npm run test:python:deploy && npm run test:python:warm && npm run test:python:guard && npm run test:python:lora && npm run test:python:fleet && npm run test:python:services && npm run test:python:master && npm run test:python:runtime",
    "perf:worklet": "node scripts/worklet-cpu-gate.cjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "audio:gate": "bash scripts/audio-gate.sh",
    "proof:turn": "node scripts/turn-live-proof.mjs",
    "proof:ice-recovery": "node scripts/ice-recovery-live-proof.mjs",
    "proof:mjpeg": "node scripts/mjpeg-live-proof.mjs",
    "proof:webgpu": "node scripts/webgpu-live-proof.mjs",
    "proof:ffmpeg-whitelist": "tsx scripts/ffmpeg-whitelist-proof.ts",
    "probe:apis": "node scripts/browser-api-probe.mjs",
    "verify:rls-live": "tsx scripts/verify-rls-live.ts",
    "proof:agentrun-race": "tsx scripts/agentrun-race-repro.ts",
    "proof:chunkupload-race": "tsx scripts/chunkupload-race-repro.ts",
    "check:library-links": "node scripts/check-library-links.mjs",
    "upload:library-music": "node scripts/upload-library-music.mjs",
    "apply:prompts": "tsx scripts/apply-prompt-catalog.ts",
    "sync:env": "node scripts/sync-env-values.mjs",
    "test:rls": "tsx scripts/verify-rls-live.ts --gate",
    "demo:gif": "node scripts/make-demo-gif.mjs",
    "rls:status": "node scripts/rls-status.mjs",
    "nightly:rls": "bash scripts/rls-nightly-check.sh",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/postgrest-js": "^2.112.3",
    "@supabase/supabase-js": "^2.112.3",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "lucide-react": "^0.546.0",
    "mediasoup": "^3.26.0",
    "mediasoup-client": "^3.22.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "^5.1.2",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8",
    "glob": "^11.0.0",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "mediasoup@3.26.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
