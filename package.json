{
  "name": "audioMONASTRY",
  "private": true,
  "version": "1.10.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "worker": "tsx services/taskWorker.ts",
    "build": "vite build && node build-worklets.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:stress": "playwright test tests/e2e/stress.spec.ts",
    "stress:hetzner": "node scripts/hetzner/stress-test.mjs",
    "stress:sfu": "node scripts/hetzner/sfu-stress-test.mjs",
    "stress:sfu-rtp": "node scripts/hetzner/sfu-rtp-run.mjs",
    "stress:sfu-rtp-multi": "node scripts/hetzner/sfu-rtp-multi-run.mjs",
    "build:sfu-test": "esbuild scripts/hetzner/sfu-rtp-entry.js --bundle --platform=browser --format=iife --outfile=public/sfu-rtp-test.js",
    "build:wasm-hrtf": "cd src/audio/wasm/hrtf_conv && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/hrtf_conv.wasm ../../../../public/hrtf/hrtf_conv.wasm",
    "generate:golden": "tsx scripts/generate-golden-wav.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:memo": "node scripts/check-react-memo.mjs",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "verify": "tsc --noEmit && vitest run && node scripts/validate-interface-boundaries.mjs",
    "verify:boundary": "node scripts/validate-interface-boundaries.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "lucide-react": "^0.546.0",
    "mediasoup": "^3.26.0",
    "mediasoup-client": "^3.22.0",
    "motion": "^12.23.24",
    "node": "^26.7.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tone": "^15.1.22",
    "unzipper": "^0.12.5",
    "ytdl-core": "^4.11.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8",
    "glob": "^11.0.0"
  },
  "allowScripts": {
    "mediasoup@3.26.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
