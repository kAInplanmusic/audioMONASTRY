# ============================================================================
# audioMONASTRY · Deploy-Variablen (Beispiel)
# ----------------------------------------------------------------------------
# Kopieren nach .env.deploy und Werte eintragen. Danach:
#   set -a; . ./.env.deploy; set +a; bash deploy.sh
# .env.deploy ist in .gitignore (kann API-Keys enthalten).
# ============================================================================

# Ziel-Instanz (IP oder Hostname, ohne user@)
DEPLOY_HOST=1.2.3.4

# Pflicht für HTTPS/iPhone-Mikrofon: echte Domain mit A-Record auf die IP
DEPLOY_DOMAIN=audiomonastry.example

# SSH-Key (Standard: ~/.ssh/id_ed25519)
DEPLOY_SSH_KEY=/home/deinuser/.ssh/id_ed25519

# docker = Compose mit Caddy/HTTPS (empfohlen); node = nur Node-Prozess
DEPLOY_MODE=docker

# 1 = lokale .env mit echten Keys auf den Server kopieren
DEPLOY_SYNC_ENV=1

# Remote-Verzeichnis
DEPLOY_REMOTE_DIR=/opt/audiomonastry

# Verbindliche RunPod-Flotte: 7 KI-Pods + 1 visPod, heterogene 32/48/96 GB GPUs.
# Keine echten Tokens oder Passwoerter in dieser Datei ablegen.
# GPU- und Modell-Live-Status sind NICHT allein durch Env-Konfiguration bestaetigt.
# Architektur/Modelle: docs/RUNPOD_FLEET_SSOT.md
AI_FLEET_MODE=pods

# Nur serverseitig/auf dem kontrollierten Deployment-Host konfigurieren:
# RP_API_KEY=<RunPod-Control-Plane-API-Key, nicht RunPod-S3-Key>
# AI_POD_TOKEN=<zufaelliges mindestens 32-stelliges Pod-Authentifizierungssecret>
# CFS3_ACCESS_KEY=<Cloudflare R2 S3 Access Key ID>
# CFS3_SECRET_KEY=<Cloudflare R2 S3 Secret Access Key>
# CFS3_BUCKET=<tatsaechlicher Bucketname fuer weights/>
# CFR2_ACCOUNT_ID=<Cloudflare R2 Account ID>
# RP_POD_IMAGE=<gepinnter GHCR Container Digest/Tag>
# RP_VIS_IMAGE=<gepinnter Container Digest/Tag fuer vis>
# RP_REGISTRY_AUTH_ID=<RunPod Credential-ID nur bei privatem GHCR>
# HF_TOKEN=<nur falls Repo gated>
# NIE: API-Keys im Repository, in CI-Ausgaben oder in VITE_-Variablen speichern.
