# ============================================================================
# audioMONASTRY · Deploy-Variablen (Beispiel)
# ----------------------------------------------------------------------------
# Kopieren nach .env.deploy und Werte eintragen. Danach:
#   set -a; . ./.env.deploy; set +a; bash deploy.sh
# .env.deploy ist in .gitignore (kann API-Keys enthalten).
# ============================================================================

# Ziel-Instanz (IP oder Hostname, ohne user@)
DEPLOY_HOST=1.2.3.4

# Pflicht für HTTPS/iPhone-Mikrofon: echte Domain mit A-Record auf die IP
DEPLOY_DOMAIN=audiomonastry.example

# SSH-Key (Standard: ~/.ssh/id_ed25519)
DEPLOY_SSH_KEY=/home/deinuser/.ssh/id_ed25519

# docker = Compose mit Caddy/HTTPS (empfohlen); node = nur Node-Prozess
DEPLOY_MODE=docker

# 1 = lokale .env mit echten Keys auf den Server kopieren
DEPLOY_SYNC_ENV=1

# Remote-Verzeichnis
DEPLOY_REMOTE_DIR=/opt/audiomonastry

# Vast-Flotte: acht Rollen mit passenden GPUs, maximal 8 EUR/h ohne Hetzner/Supabase
# Architektur/Modelle: docs/VAST_MIGRATION_STATUS_2026-11-11.md
AI_FLEET_MODE=pods
# GPU provider selected for the Vast migration; generated URLs/prices come from verified runtime.env.
AI_GPU_PROVIDER=vast
VAST_API_KEY=

# Digest map is recorded automatically after all image builds and identity checks pass.
VAST_IMAGES_FILE=deploy/vast/images.json
# Cold-start transfer limit must be verified before the first paid test.
VAST_COLD_START_MAX_EUR=-1
