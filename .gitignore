node_modules
dist
public/worklets
dist/worklets
.env
.env.*
!.env.example
!.env.hetzner.example
!.env.deploy.example

# RC1-009 (Audit 2026-09-23): Schluessel-/Zertifikatsmaterial und
# Notebook-Reste pauschal ausschliessen. Praevention, kein Vorfall - aktuell
# ist nichts dergleichen getrackt (geprueft mit
# `git ls-files | rg -i "\.pem$|\.key$|id_rsa|\.ipynb$"` -> nur tsconfig.json
# als Fehltreffer auf "config.json"). Eine .gitignore-Regel schuetzt nur vor
# dem versehentlichen `git add .` - genau das ist der realistische Fehlerpfad.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.ipynb
credentials.json
secrets.json

# RC2-Sicherungskopien: Konsolidierungs-/Apply-Backups der SSOT
# (MASTERTODOENDE.json.bak-*). Sie gehoeren nicht in die Historie - der Inhalt
# ist ueber git selbst rekonstruierbar. Der Betreiber kann sie jederzeit loeschen.
*.bak-*

# lokale Agent-Tooling-Konfiguration (enthält API-Keys)
deepcode/

# ONNX-Modelle (gross, separat via scripts/download-models.sh)
public/models/

# Orchester-CC0-Audiodateien (gross, via npm run download:orchestral)
public/data/orchestral/

# Python
__pycache__/
*.pyc

# Test-Coverage (Vitest/SonarQube)
coverage/

# Playwright E2E
test-results/
playwright-report/
playwright/.cache/

# Vitest-JSON-Report (CI-Gate gegen übersprungene Tests, CI-P1-001)
.vitest-report.json

# Generiertes SFU-RTP-Testbundle (npx esbuild scripts/hetzner/sfu-rtp-entry.js ...)
public/sfu-rtp-test.js

# Rust
services/audio-runtime/target/

# NAPI-Rust-Binary wird aus Quellcode gebaut (Dockerfile.multistage)
services/mixer/*.node

# Rust/WASM build artifacts
src/audio/wasm/hrtf_conv/target/
src/audio/wasm/dspKernel_rs/target/

# Manuell gespeicherte Live-Test-Logs (lokal, koennen Secrets enthalten)
logs/

# Laufzeitdateien des Rollen-Deploys (F6): `scripts/hetzner/wire-rtc.sh` erzeugt
# hier `coturn/turnserver.conf` mit dem TURN-Static-Auth-Secret. Die Datei gehoert
# NUR auf den Knoten - niemals ins Repo (dieselbe Regel wie fuer .env).
runtime/
.worktrees/

# Demo-Tracks (kommerzielle Fremdaufnahmen, keine dokumentierte Freigabe):
# NICHT im Repo/Image ausliefern - nur mit Betreiberentscheidung und Lizenzbeleg.
public/music/

# Zwischenaufnahme des Demo-GIF (scripts/make-demo-gif.mjs)
.demo-video/
