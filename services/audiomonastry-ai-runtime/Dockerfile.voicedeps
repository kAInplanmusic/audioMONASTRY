# audioMONASTRY · Voice-Clone-/Convert-Schicht (fish-speech + OpenVoice V2)
# =======================================================================
# Warum eine eigene SCHICHT mit eigener venv und nicht ein Paket im Haupt-Image:
# beide Zielpakete bringen einen gepinnten, inkompatiblen Stack mit.
#
# Gemessen am 2026-09-16 (pip-Aufloesung im laufenden Runtime-Image):
#   * rvc-python:  "Requested omegaconf==2.0.6 ... has invalid metadata:
#     PyYAML (>=5.1.*)" -> ResolutionImpossible mit pip >= 24.1; verlangt
#     ausserdem numpy<=1.23.5 (Image: 2.2.2) und fairseq==0.12.2.
#     -> RVC ist auf einem modernen Stack so nicht installierbar. Ersetzt durch
#        OpenVoice V2 (MIT) fuer die Stimmonvertierung, siehe unten.
#   * fish-speech: verlangt numpy<=1.26.4 und torch<=2.4.1 (Image: torch 2.6.0,
#     numpy 2.2.2) -> im Haupt-Environment ein Konflikt mit den laufenden Rollen.
#
# Loesung: beide Pakete liegen in einer eigenen venv (/opt/voiceclone-venv).
# Unser Haupt-Environment (torch 2.6.0, transformers 4.57.3, numpy 2.2.2) bleibt
# unangetastet - kein Risiko fuer ears/voiceGen/orchestrator. Die Handler rufen
# die Bridges als Subprozess mit dem venv-Interpreter auf; fehlt venv oder Modell,
# meldet der Handler ehrlich MODEL_UNAVAILABLE statt zu crashen.
#
# Lizenzen (wichtig fuer die Vermarktung):
#   * fish-speech CODE (Repo, Tag v1.5.1)          -> Apache-2.0
#   * fish-speech GEWICHTE (fishaudio/fish-speech-1.5) -> cc-by-nc-sa-4.0
#     (NICHT kommerziell, Share-Alike) - gleiche Einordnung wie FLUX.2/Ministral
#     im 8-Instanzen-Plan.
#   * OpenVoice V2 (myshell-ai/OpenVoice, Commit gepinnt) -> MIT, Gewichte MIT.
#
# Build:
#   docker build --platform=linux/amd64 \
#     -f services/audiomonastry-ai-runtime/Dockerfile.voicedeps \
#     --build-arg BASE_IMAGE=ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:8roles-v2 \
#     -t ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:<neu> \
#     services/audiomonastry-ai-runtime
ARG BASE_IMAGE=ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:8roles-v2
FROM ${BASE_IMAGE}

#: Code-/Gewichtsstaende, bewusst gepinnt (Gewichte und Code muessen zusammenpassen:
#: das PyPI-Paket `fish-speech` steht auf 0.1.0 und passt NICHT zu den 1.5-Gewichten).
ARG FISH_SPEECH_TAG=v1.5.1
ARG OPENVOICE_COMMIT=74a1d147b17a8c3092dd5430504bd83ef6c7eb23

USER root
WORKDIR /opt/samplemonk-ai

# Build-Werkzeuge fuer die Abhaengigkeiten (u. a. faster-whisper/ctranslate2,
# pydub -> ffmpeg, portaudio fuer fish-speechs optionales Streaming).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential git ffmpeg libsndfile1 portaudio19-dev \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# GATE 1: venv + torch (die Basis von fish-speech; openvoice laeuft damit mit)
# ---------------------------------------------------------------------------
RUN python -m venv /opt/voiceclone-venv \
 && /opt/voiceclone-venv/bin/pip install --quiet --upgrade pip setuptools wheel \
 && /opt/voiceclone-venv/bin/pip install --quiet \
      --index-url https://download.pytorch.org/whl/cu124 torch==2.4.1 torchaudio==2.4.1 \
 && /opt/voiceclone-venv/bin/python -c "import torch; print('GATE ok: torch', torch.__version__)"

# ---------------------------------------------------------------------------
# GATE 2: fish-speech (Code auf Tag, Gewichte kommen zur Laufzeit aus dem Hub)
# ---------------------------------------------------------------------------
RUN git clone --quiet --depth 1 --branch ${FISH_SPEECH_TAG} \
      https://github.com/fishaudio/fish-speech /opt/fish-speech \
 && /opt/voiceclone-venv/bin/pip install --quiet -e /opt/fish-speech --no-deps \
 && /opt/voiceclone-venv/bin/pip install --quiet \
      "numpy<=1.26.4" "transformers>=4.45.2" hydra-core kui "einx[torch]==0.2.2" \
      tiktoken vector_quantize_pytorch==1.14.24 loguru ormsgpack soundfile \
      librosa safetensors einops pyrootutils resampy zstandard pydub cachetools \
 && /opt/voiceclone-venv/bin/python -c "\
import torch;\
from fish_speech.inference_engine import TTSInferenceEngine;\
from fish_speech.models.text2semantic.inference import launch_thread_safe_queue;\
from fish_speech.models.vqgan.inference import load_model;\
from fish_speech.utils.schema import ServeTTSRequest, ServeReferenceAudio;\
print('GATE ok: fish-speech Importe', torch.__version__)"

# ---------------------------------------------------------------------------
# GATE 3: OpenVoice (MIT) auf gepinntem Commit
# ---------------------------------------------------------------------------
RUN git clone --quiet https://github.com/myshell-ai/OpenVoice /opt/openvoice \
 && git -C /opt/openvoice checkout --quiet ${OPENVOICE_COMMIT} \
 && /opt/voiceclone-venv/bin/pip install --quiet -e /opt/openvoice --no-deps \
 && /opt/voiceclone-venv/bin/pip install --quiet \
      "numpy<=1.26.4" librosa soundfile pydub faster-whisper wavmark \
      eng_to_ipa inflect unidecode pypinyin cn2an jieba langid \
 && /opt/voiceclone-venv/bin/python -c "\
import numpy, torch;\
from openvoice.api import ToneColorConverter;\
print('GATE ok: OpenVoice Importe', numpy.__version__, torch.__version__)"

# ---------------------------------------------------------------------------
# GATE 4: die Bridges selbst (unsere Vertragsschicht) - Imports ohne Modelle
# ---------------------------------------------------------------------------
COPY voice_clone_bridge.py voice_convert_bridge.py ./voice_bridge/
RUN /opt/voiceclone-venv/bin/python voice_bridge/voice_clone_bridge.py --selftest \
 && /opt/voiceclone-venv/bin/python voice_bridge/voice_convert_bridge.py --selftest \
 && python voice_bridge/voice_clone_bridge.py --selftest 2>&1 | grep -q "venv" \
 && echo "GATE ok: Bridges laden im venv; ohne venv kommt die klare Meldung"

RUN chown -R samplemonk:samplemonk /opt/voiceclone-venv /opt/fish-speech /opt/openvoice voice_bridge
USER samplemonk
