# Role dependency profiles. Model identities remain in model_manifest.json.
FROM ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod@sha256:c24a10ec750a18c8e0ddcb8fe89064efc04dbb20c57e63817dbd22d2ab8d9854 AS voice
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git sox libsox-fmt-all && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir qwen-tts==0.1.1 transformers==4.57.3 huggingface-hub==0.36.2 \
    diffusers==0.37.0 einops==0.8.2 loguru==0.7.3 vector-quantize-pytorch==1.27.15 \
    pytorch-wavelets==1.3.0 PyWavelets==1.9.0 diskcache==5.6.3 toml==0.10.2 \
    peft==0.18.0 torchao==0.16.0 torchcodec==0.9.1 descript-audiotools==0.7.2 ftfy==6.3.1
RUN git init -q /opt/acestep \
    && git -C /opt/acestep fetch -q --depth 1 https://github.com/ace-step/ACE-Step-1.5 ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git -C /opt/acestep checkout -q FETCH_HEAD \
    && test "$(git -C /opt/acestep rev-parse HEAD)" = ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git init -q /opt/moss-tts \
    && git -C /opt/moss-tts fetch -q --depth 1 https://github.com/OpenMOSS/MOSS-TTS 934d6826b084c46a0d033402174d5f8ac4ed2519 \
    && git -C /opt/moss-tts checkout -q FETCH_HEAD \
    && test "$(git -C /opt/moss-tts rev-parse HEAD)" = 934d6826b084c46a0d033402174d5f8ac4ed2519
ENV PYTHONPATH=/opt/acestep:/opt/moss-tts NUMBA_CACHE_DIR=/data/numba-cache ACESTEP_PROJECT_ROOT=/data/acestep
COPY *.py *.json ./
COPY workflows/ ./workflows/
RUN python -c "import torch; from qwen_tts import Qwen3TTSModel; import acestep.handler, acestep.inference; from moss_soundeffect_v2 import MossSoundEffectPipeline; assert torch.__version__.startswith('2.10.0'); print('voice/music profile imports pass')"
RUN chown -R 10001:10001 /opt/audiomonastry-ai /data
USER 10001:10001
ENTRYPOINT ["python", "-u", "pod_start.py"]
CMD []

FROM ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod@sha256:c24a10ec750a18c8e0ddcb8fe89064efc04dbb20c57e63817dbd22d2ab8d9854 AS executor
USER root
RUN pip install --no-cache-dir transformers==5.20.0 accelerate==1.13.0
COPY *.py *.json ./
COPY workflows/ ./workflows/
RUN python -c "from transformers import Qwen3_5ForConditionalGeneration, AutoModelForImageTextToText; print('Qwen3.5 native multimodal class available')"
RUN chown -R 10001:10001 /opt/audiomonastry-ai
USER 10001:10001
ENTRYPOINT ["python", "-u", "pod_start.py"]
CMD []

FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime AS ears
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HOME=/data/hf-cache NUMBA_CACHE_DIR=/data/numba-cache
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg libsndfile1 python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/ears-venv
ENV PATH="/opt/ears-venv/bin:${PATH}"
WORKDIR /opt/audiomonastry-ai
COPY requirements-beat-this.lock requirements-basic-pitch.lock requirements-basic-pitch-runtime.lock ./
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cu128 \
    torch==2.9.1+cu128 torchaudio==2.9.1+cu128 torchvision==0.24.1+cu128 \
    transformers==4.57.1 huggingface-hub==0.36.2 accelerate==1.13.0 \
    soundfile==0.13.1 scipy==1.16.2 librosa==0.11.0 tiktoken==0.12.0 \
    muq==0.1.0 ema-pytorch==0.7.9 omegaconf==2.3.0 loguru==0.7.3 \
    fastapi==0.141.1 uvicorn==0.46.0 pydantic==2.13.0 runpod==1.12.0 \
    -r requirements-beat-this.lock -r requirements-basic-pitch-runtime.lock \
    && pip install --no-cache-dir --no-deps --require-hashes -r requirements-basic-pitch.lock
COPY *.py *.json ./
COPY workflows/ ./workflows/
RUN python -c "from transformers import ClapModel; import torch, muq, beat_this.inference, basic_pitch.inference; from transformers.dynamic_module_utils import get_class_from_dynamic_module; assert torch.__version__.startswith('2.9.1'); print('ears profile imports pass')"
RUN useradd --system --uid 10001 audiomonastry && mkdir -p /data/weights /data/hf-cache /data/numba-cache \
    && chown -R 10001:10001 /data /opt/audiomonastry-ai
USER 10001:10001
ENTRYPOINT ["python", "-u", "pod_start.py"]
CMD []

FROM vllm/vllm-openai:v0.33.0 AS brain
USER root
WORKDIR /opt/audiomonastry-ai
RUN pip install --no-cache-dir runpod==1.12.0 soundfile==0.13.1 scipy==1.16.2
COPY *.py *.json ./
COPY workflows/ ./workflows/
RUN python -c "from vllm import LLM; from transformers import Qwen3_5ForConditionalGeneration; print('brain FP8 engine available')"
RUN useradd --system --uid 10001 audiomonastry && mkdir -p /data/weights /data/hf-cache /data/numba-cache \
    && chown -R 10001:10001 /data /opt/audiomonastry-ai
ENV HF_HOME=/data/hf-cache NUMBA_CACHE_DIR=/data/numba-cache
USER 10001:10001
ENTRYPOINT ["python", "-u", "pod_start.py"]
CMD []
