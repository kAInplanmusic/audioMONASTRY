# Dedicated YuE2 song Pod: dependencies require torch 2.10.0 and
# transformers 4.57.6, incompatible with the older shared runtime image.
# This is a BUILD CONFIGURATION, not a CUDA/inference acceptance certificate.
# Upstream package license and model's non-commercial restrictions must be
# reviewed before any commercially accessible deployment.
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime

ARG YUE2_SOURCE_COMMIT=88da114a67df892af0329472073b96a5ef700b93
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/tmp/hf-cache \
    NUMBA_CACHE_DIR=/tmp/numba-cache \
    AI_ROLE=song \
    AI_RESIDENT_ONLY=1 \
    AI_RUNTIME_DEVICE=cuda

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -c "import torch; assert torch.__version__.startswith('2.10.0'), torch.__version__"
RUN pip install --no-cache-dir \
    "transformers==4.57.6" "huggingface-hub==0.36.2" \
    "safetensors==0.7.0" "tiktoken==0.12.0" \
    "numpy==2.2.6" "soundfile==0.13.1" "accelerate==1.13.0" \
    "fastapi>=0.115,<1" "uvicorn>=0.34,<1" "pyyaml>=6.0,<7" "psutil>=6,<9"

RUN git init -q /opt/yue2 \
    && git -C /opt/yue2 fetch -q --depth 1 https://github.com/tidesea/yue "$YUE2_SOURCE_COMMIT" \
    && git -C /opt/yue2 checkout -q FETCH_HEAD \
    && test "$(git -C /opt/yue2 rev-parse HEAD)" = "$YUE2_SOURCE_COMMIT" \
    && pip install --no-cache-dir --no-deps /opt/yue2 \
    && rm -rf /opt/yue2/.git \
    && python -c "import yue2; from yue2 import YuE2Pipeline; print('YuE2 source import ok')"

WORKDIR /opt/audiomonastry-ai
COPY app.py registry.py model_manifest.json model_manager.py pod_jobs.py \
     vram_probe.py handlers.py handlers_runpod.py handlers_fleet2026.py \
     handlers_voice.py handlers_stems.py handlers_ears.py \
     handlers_sonicmaster.py startup_model_proof.py pod_start.py \
     stem_crossover.py stem_warp.py moa_orchestrator.py \
     comfyui_adapter.py mcp_runtime.py ./
COPY workflows/ ./workflows/
RUN useradd --system --uid 10001 audiomonastry \
    && mkdir -p /tmp/hf-cache /tmp/numba-cache \
    && chown -R audiomonastry:audiomonastry /opt/audiomonastry-ai /tmp/hf-cache /tmp/numba-cache
USER audiomonastry
EXPOSE 8000
ENTRYPOINT ["python", "pod_start.py"]
