# SampleMONK AI Runtime – Code-/Manifest-Patch (schneller Rollen-Update)
# =====================================================================
# Leitet ein Image vom bewährten Runtime-Image ab und tauscht NUR den
# Python-Code der Runtime + das Rollen-Manifest aus. Zweck: Änderungen an
# `model_manifest.json`, `registry.py`, `model_manager.py` und den Handlern
# brauchen keinen 30-minütigen Voll-Build inkl. pip-Installationen – die
# Abhängigkeiten (torch/transformers/diffusers/demucs/pyannote/qwen_tts)
# bleiben unverändert.
#
# WICHTIG (live belegt 2026-09-15): Ein reiner Manifest-Patch auf einem
# älteren Basis-Image ist NICHT ausreichend. Das Image `:8roles-b7efbbd` trug
# das neue Manifest, aber die alte `model_manager.py`, die `quantization:
# "awq-int4"` (Rolle ears → qwen2-audio-7b) nicht kannte. Folge: jeder Worker
# startete und starb sofort (Crash-Loop, Jobs hingen in der Queue, im Log nur
# wiederholte system-"start container"-Zeilen ohne Container-Ausgabe).
# Deshalb kopiert dieses Dockerfile Code UND Manifest – und baut ein Gate ein.
#
# Der Voll-Build bleibt der kanonische Pfad
# (`.github/workflows/runpod-deploy.yml` → Dockerfile.runpod).
#
# Build:
#   docker build --platform=linux/amd64 \
#     -f services/audiomonastry-ai-runtime/Dockerfile.manifest \
#     --build-arg BASE_IMAGE=ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:<bewaehrt> \
#     -t ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:<neu> \
#     services/audiomonastry-ai-runtime
#
# Hinweis: Container-interne Pfade (/opt/samplemonk-ai) und der Worker-User
# (samplemonk) sind bewusst noch nicht umbenannt – das erfordert einen
# bestaetigten Voll-Build (TODO NOMEN-P1-001).
ARG BASE_IMAGE=ghcr.io/kainplanmusic/audiomonastry-ai-runtime-runpod:8roles-v2
FROM ${BASE_IMAGE}

WORKDIR /opt/samplemonk-ai

# Das Basis-Image endet als uid 10001 (`samplemonk`) – fuer COPY/chown zurueck
# auf root; am Ende laeuft der Worker wieder unprivilegiert als samplemonk.
USER root

# Code + Manifest der Runtime auf den aktuellen Repo-Stand bringen.
# Bewusst NUR die Runtime-Quellen – keine Abhängigkeits-Updates.
COPY model_manifest.json registry.py model_manager.py runpod_worker.py \
     app.py mcp_runtime.py handlers.py handlers_runpod.py moa_orchestrator.py \
     predownload.py runtime_config.yaml ./

RUN chown samplemonk:samplemonk /opt/samplemonk-ai/*.py /opt/samplemonk-ai/*.json /opt/samplemonk-ai/*.yaml

# ---------------------------------------------------------------------------
# GATE: Code und Manifest müssen für JEDE Rolle zusammenpassen.
# Genau hier scheiterte der Manifest-only-Patch: das Manifest nutzte einen
# Quantisierungs-Wert, den die (alte) model_manager.py nicht kannte. Das Gate
# konfiguriert den ModelManager pro Rolle aus dem Manifest selbst – so kann
# keine Rollen-/Code-Drift mehr in ein Image gelangen. Läuft ohne GPU, weil
# `configure` nur validiert (kein Modell-Load).
# ---------------------------------------------------------------------------
RUN python -c "\
import json, registry;\
from model_manager import ModelManager;\
roles = list(json.load(open('model_manifest.json'))['roles']);\
assert set(roles) == set(registry.ROLE_IDS), f'Registry/Manifest-Rollen driften: {roles} vs {registry.ROLE_IDS}';\
[ModelManager().configure(registry.load_manifest(r)) or print('role ok:', r) for r in roles];\
print('GATE ok: Code + Manifest passen fuer', len(roles), 'Rollen')"

# Zurueck auf den unprivilegierten Worker-User (wie im Basis-Image).
USER samplemonk
