# Keep an already built dependency profile; replace only the audited runtime.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG PROFILE
USER root
ENV HOME=/data/home XDG_CACHE_HOME=/data/cache TRITON_CACHE_DIR=/data/triton-cache TORCHINDUCTOR_CACHE_DIR=/data/torchinductor-cache
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/home /data/cache /data/triton-cache /data/torchinductor-cache \
    && chown -R 10001:10001 /data/home /data/cache /data/triton-cache /data/torchinductor-cache
WORKDIR /opt/audiomonastry-ai
# The studio's selected 96-GB Blackwell GPU requires an sm_120-capable wheel.
RUN if [ "$PROFILE" = "studio" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0+cu128 torchaudio==2.8.0+cu128 torchvision==0.23.0+cu128 \
      && python -c "import torch; assert 'sm_120' in torch._C._cuda_getArchFlags(); print('Blackwell kernel architecture verified')"; \
    fi
RUN if [ "$PROFILE" = "ears" ]; then \
      pip install --no-cache-dir x-transformers==2.4.14 einx==0.3.0 ema-pytorch==0.7.7 beartype==0.21.0; \
    fi
COPY *.py *.json ./
COPY workflows/ ./workflows/
RUN python -m compileall -q /opt/audiomonastry-ai \
    && python -c "import registry; from model_manager import ModelManager; [ModelManager().configure(registry.load_manifest(role)) for role in registry.ROLE_IDS]; print('all role contracts valid')" \
    && chown -R 10001:10001 /opt/audiomonastry-ai
USER 10001:10001
ENTRYPOINT ["python", "-u", "pod_start.py"]
CMD []
