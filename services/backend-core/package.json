{
  "name": "backend-core",
  "version": "1.0.0",
  "description": "Unified Backend Core for Audio Routing, Signaling, and AI Processing",
  "main": "node/index.js",
  "scripts": {
    "start:node": "node node/index.js",
    "start:python": "cd python && uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:python:dev": "cd python && uvicorn main:app --reload",
    "start": "concurrently \"npm run start:node\" \"npm run start:python\"",
    "test": "node --check node/index.js && node --check node/audio-routing.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
