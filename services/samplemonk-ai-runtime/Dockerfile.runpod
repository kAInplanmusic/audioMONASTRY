# SampleMONK AI Runtime – RunPod Serverless Worker
# =================================================
# Ein Image für alle drei Flotten-Rollen (brain | ears | voiceGen). Die Rolle
# wird zur Laufzeit über AI_ROLE gewählt; der Worker lädt daraus nur die Modelle
# des Rollen-Manifests (model_manifest.json → "roles"). Die Kernabhängigkeiten
# (vLLM für brain, TTS-/Audio-Stacks für voiceGen/ears) werden per Build-Arg
# zugeschaltet.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/hf-cache \
    AI_ROLE=""

ARG AI_INSTALL_VOICE_AI=0
ARG AI_INSTALL_AUDIO_AI=0
# Brain-Rolle: vLLM für den OpenAI-kompatiblen LLM-Endpoint (/v1/chat/completions).
ARG AI_INSTALL_VLLM=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 sox curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/samplemonk-ai

COPY requirements.in ./
RUN pip install --no-cache-dir -r requirements.in

COPY requirements-voice-ai.lock ./
RUN if [ "$AI_INSTALL_VOICE_AI" = "1" ]; then \
      pip install --no-cache-dir -r requirements-voice-ai.lock; \
    fi

COPY requirements-audio-ai.lock ./
RUN if [ "$AI_INSTALL_AUDIO_AI" = "1" ]; then \
      pip install --no-cache-dir -r requirements-audio-ai.lock; \
    fi

RUN if [ "$AI_INSTALL_VLLM" = "1" ]; then \
      pip install --no-cache-dir "vllm>=0.8"; \
    fi

# RunPod Serverless SDK (Worker + API)
RUN pip install --no-cache-dir runpod==1.12.0

# ---------------------------------------------------------------------------
# Abhängigkeits-Erzwingung + harte Prüfung
# ---------------------------------------------------------------------------
# transformers 4.57.x verlangt `huggingface-hub>=0.34,<1.0`. Andere Stacks
# (qwen-tts / diffusers) ziehen sonst huggingface-hub 1.x herein – die Folge ist
# ein ImportError-Kaskade, die im Worker nur als generisches MODEL_UNAVAILABLE
# ankommt (genau so passiert am 2026-09-10). Deshalb hier NACH allen Lock-
# Installs hart erzwingen und den echten Worker-Pfad prüfen.
RUN pip install --no-cache-dir "huggingface-hub>=0.34.0,<1.0"

# Importiert die Namen wie der Worker (`_require_lib` nutzt fromlist=["*"]) –
# ein simples `import transformers` allein löst den Versionscheck NICHT aus und
# hätte den Fehler übersehen.
RUN python -c "\
import huggingface_hub, transformers; \
print('huggingface-hub', huggingface_hub.__version__, '| transformers', transformers.__version__); \
exec('from transformers import *'); \
assert huggingface_hub.__version__.split('.')[0] == '0', 'huggingface-hub muss <1.0 sein'; \
print('transformers Import-Pfad ok (worker-identisch)')"

# Kennt transformers das Brain-Modell? (Qwen3 gibt es erst ab transformers >= 4.51.)
RUN python -c "from transformers import AutoConfig; print('qwen3 config ok:', AutoConfig.from_pretrained('Qwen/Qwen3-14B').model_type)"

# ---------------------------------------------------------------------------
# Rollen-Gewichte einbacken (optional, AI_BAKE_ROLE setzen)
# ---------------------------------------------------------------------------
# Warum: ein RunPod Network Volume hilft nur in einem der 18 volume-fähigen
# Rechenzentren – und dort gibt es keinen A40/A6000-Pool (getestet EU-RO-1,
# EU-NL-1 → Jobs hängen in der Queue). Die Gewichte stattdessen ins Image zu
# legen funktioniert mit dem bewährten GPU-Pool und ergänzt sich mit
# `workersStandby=1` (Image bleibt hostseitig vorgehalten, kein Image-Pull).
#
# Zielpfad ist bewusst `/data/hf-cache` (identisch zum `HF_HOME`): wird später
# doch ein Volume auf `/data` gemountet, überdeckt es den eingebackenen Cache.
#
# Wichtig: hier NICHT als root backen und danach `chown -R /data` – ein
# rekursives chown über 30+ GB erzeugt einen zweiten Riesen-Layer.
#
# Der `AutoConfig`-Prefetch oben (Zeile 68) läuft als root und legt dabei
# `/data/hf-cache/hub/.locks/...` root-eigen an. Ohne rekursives chown scheitert
# der Bake als uid 10001 mit `PermissionError` auf genau diese Lock-Datei – das
# war die echte Ursache des roten Brain-Builds (nicht der Plattenplatz, der
# Check war grün). Da zu DIESEM Zeitpunkt noch keine Gewichte im Cache liegen,
# ist das rekursive chown hier klein – die 30-GB-Warnung gilt erst NACH dem Bake.
ARG AI_BAKE_ROLE=""
# Anzahl Layer für die Gewichte (Qwen3-14B: 8 Shards à ~4 GB → 4 Layer à ~8 GB,
# damit kein Einzel-Layer die Registry-Grenzen sprengt).
ARG AI_BAKE_GROUPS=4

COPY predownload.py registry.py model_manifest.json ./
RUN mkdir -p /data/hf-cache \
    && useradd --system --uid 10001 samplemonk \
    && chown -R samplemonk:samplemonk /opt/samplemonk-ai /data
USER samplemonk
RUN if [ -n "$AI_BAKE_ROLE" ]; then python predownload.py --role "$AI_BAKE_ROLE" --group 0 --groups "$AI_BAKE_GROUPS"; fi
RUN if [ -n "$AI_BAKE_ROLE" ]; then python predownload.py --role "$AI_BAKE_ROLE" --group 1 --groups "$AI_BAKE_GROUPS"; fi
RUN if [ -n "$AI_BAKE_ROLE" ]; then python predownload.py --role "$AI_BAKE_ROLE" --group 2 --groups "$AI_BAKE_GROUPS"; fi
RUN if [ -n "$AI_BAKE_ROLE" ]; then python predownload.py --role "$AI_BAKE_ROLE" --group 3 --groups "$AI_BAKE_GROUPS"; fi
# Beleg für „ist wirklich drin" – auch ohne Log-Zugriff prüfbar per `docker run`.
RUN du -sh /data/hf-cache 2>/dev/null || true
USER root

COPY app.py model_manager.py mcp_runtime.py handlers.py handlers_runpod.py runpod_worker.py ./
COPY runtime_config.yaml ./
# Kein rekursives chown über /data (siehe oben) – nur die kleinen App-Dateien.
RUN chown samplemonk:samplemonk /opt/samplemonk-ai/*.py /opt/samplemonk-ai/*.json /opt/samplemonk-ai/*.yaml

USER samplemonk

# RunPod Serverless Worker
ENTRYPOINT ["python", "runpod_worker.py"]
