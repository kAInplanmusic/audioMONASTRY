# audioMONASTRY · Production environment (generated)
# ============================================================================

# Frontend runtime endpoints (empty for same-origin)
VITE_API_BASE_URL=""
VITE_SOCKET_IO_SIGNALING_URL=""
VITE_SIGNALING_WS_URL=""
VITE_SIGNALING_HTTP_URL=""
VITE_SIGNALING_TRANSPORT_URL=""

# Phase 9 – V2 ist der einzige Audiopfad (V1 entfernt)
VITE_V2_AUDIO_MODE="v2"

# --- Supabase (Sample-/Musik-Datenbank) ---
# Leave empty for offline operation
VITE_SB_URL=""
VITE_SB_ANON_PUB=""
SB_SERVICE_ROLE=""

# --- Cloudflare R2 (Objekt-Storage für Audio-Blobs) ---
CFS3_BUCKET=""
CFS3_ACCESS_KEY=""
CFS3_SECRET_KEY=""
CFS3_ENDPOINT=""
VITE_CFR2_ACCOUNT_ID=""
VITE_CFS3_BUCKET=""

# --- Cloudflare-API-Token (Dashboard/Zone/DNS) ---
CF_API_TOKEN=""
CF_TOKEN_UT=""
CF_TOKEN_ACCOUNT=""
CF_TOKEN_KEY=""

# --- Zugangsschutz (PFLICHT fuer jeden erreichbaren Betrieb) ---
STUDIO_ACCESS_TOKEN=$(openssl rand -base64 48 | tr -d '\n' | cut -c1-64)
SESSION_SECRET=$(openssl rand -base64 48 | tr -d '\n' | cut -c1-64)
SCRAPE_TOKEN=$(openssl rand -base64 48 | tr -d '\n' | cut -c1-64)
AUDIOMONASTRY_DEV_NO_AUTH=0

# --- Kill-Switch ---
KILL_SWITCH=0
MAINTENANCE_MODE=0

# --- Alarmzustellung + Ruhe-Modus ---
ALERT_WEBHOOK_TOKEN=""
SLACK_WEBHOOK=""
DISCORD_WEBHOOK=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_QUIET_HOURS="22-7"
ALERT_QUIET_HOURS_OFF=1

# --- Grenzen ---
UPLOAD_MAX_MB=100

# --- Rechtstexte: Impressum + Datenschutz ---
LEGAL_NAME="audioMONASTRY"
LEGAL_STREET="Example Street 1"
LEGAL_CITY="12345 Example City"
LEGAL_COUNTRY="Deutschland"
LEGAL_EMAIL="contact@example.com"
LEGAL_PHONE="+49 123 456789"
LEGAL_REPRESENT="audioMONASTRY"
LEGAL_SUPERVISORY="Behörde für Datenschutz"

# --- CSP_MODE ---
CSP_MODE=report-only

# --- AI-Betriebsmodus + Kosten-Grenzen ---
AI_MODE=off
AI_VISUAL_IDLE_MS=900000
AI_HETZNER_EUR_PER_HOUR=0.054
AI_MAX_FLEET_EUR_PER_HOUR=10
AI_TARGET_FLEET_EUR_PER_HOUR=0.90
AI_MAX_STORAGE_EUR_PER_MONTH=5
AI_ESTIMATED_STORAGE_EUR_PER_MONTH=0.5

# --- RunPod-Pods (not used) ---
AI_FLEET_MODE=serverless
AI_POD_TOKEN=""

# --- Backblaze B2 (not used) ---
B2_BUCKET=""
B2_KEY_ID=""
B2_APP_KEY=""
B2_ENDPOINT=""
